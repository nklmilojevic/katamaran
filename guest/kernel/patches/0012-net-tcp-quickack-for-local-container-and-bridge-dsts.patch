diff -ruN a/net/ipv4/tcp_input.c b/net/ipv4/tcp_input.c
--- a/net/ipv4/tcp_input.c
+++ b/net/ipv4/tcp_input.c
@@ -224,6 +224,83 @@
 /* Adapt the MSS value used to make delayed ack decision to the
  * real world.
  */
+/* Classify a PSH segment relative to the peer's full-sized segments for the
+ * SO_RCVLOWAT quickack path:
+ *
+ * - KAT_PUSH_SHORT: strictly smaller than both our upper bound and the peer's
+ *   advertised MSS hint (definite sub-MSS application write that Nagle may be
+ *   holding a tail behind).
+ * - KAT_PUSH_UNCERTAIN: between the peer hint and our upper bound (e.g. a
+ *   peer that advertised a low advmss metric on a jumbo-MTU route, or a peer
+ *   behind a narrower MTU). Gets at most one capped delack timer per unread
+ *   batch, never an immediate ACK.
+ * - KAT_PUSH_NONE: non-PSH or full-sized segment; keeps stock ACK behavior.
+ *
+ * The adaptive rcv_mss estimate cannot answer this: repeated small writes
+ * settle rcv_mss at their own size although they are still sub-MSS for the
+ * sender. Instead mirror how the peer sizes its segments in tcp_sync_mss():
+ * its send MSS is
+ *
+ *	min(MSS we advertised, its path MSS) - options,
+ *	bounded by tcp_bound_to_half_wnd() to half its max_window.
+ *
+ * Inputs used here:
+ *  - tp->advmss, the MSS we advertised. Once the handshake completes it
+ *    already excludes the timestamp option on both active
+ *    (tcp_rcv_synsent_state_process) and passive (TCP_SYN_RECV in
+ *    tcp_rcv_state_process) opens; only data arriving before that point
+ *    (TCP Fast Open) still needs the deduction here.
+ *  - tp->kat_max_adv_win, the largest window we put on the wire, which is
+ *    the peer's max_window (it re-syncs its MSS whenever that grows).
+ *  - tp->rx_opt.mss_clamp, the MSS the peer advertised, minus negotiated
+ *    options. Because a peer's SYN MSS limits what it receives rather than
+ *    what it sends (e.g. a low advmss route metric on a jumbo path), this is
+ *    only a hint separating definite short pushes from uncertain ones.
+ *
+ * Our own send-side state (mss_cache, our max_window, MTU probing) only
+ * constrains segments we send and is deliberately not used.
+ */
+static u8 kat_classify_push(const struct sock *sk, const struct sk_buff *skb)
+{
+	const struct tcp_sock *tp = tcp_sk(sk);
+	unsigned int gso_size = skb_shinfo(skb)->gso_size;
+	unsigned int seg_len = skb->len;
+	unsigned int opts = tp->tcp_header_len - sizeof(struct tcphdr);
+	unsigned int ours = tp->advmss;
+	unsigned int peers = tp->rx_opt.mss_clamp;
+	unsigned int maxwin = tp->kat_max_adv_win;
+	unsigned int cutoff;
+
+	if (!(TCP_SKB_CB(skb)->tcp_flags & TCPHDR_PSH))
+		return KAT_PUSH_NONE;
+
+	if (tp->rx_opt.tstamp_ok &&
+	    ((1 << sk->sk_state) & (TCPF_SYN_SENT | TCPF_SYN_RECV)))
+		ours = ours > TCPOLEN_TSTAMP_ALIGNED ?
+		       ours - TCPOLEN_TSTAMP_ALIGNED : 0;
+
+	/* Same cutoff as tcp_bound_to_half_wnd() on the peer. */
+	cutoff = maxwin > TCP_MSS_DEFAULT ? maxwin >> 1 : maxwin;
+	if (cutoff && ours > cutoff)
+		ours = max_t(unsigned int, cutoff, 68U - tp->tcp_header_len);
+
+	peers = peers > opts ? peers - opts : 0;
+	peers = min(ours, peers);
+
+	/* A GSO/GRO skb (local veth/bridge paths pass TSO skbs through whole)
+	 * carries PSH on its last segment, which ends the write: judge that
+	 * segment, not gso_size, so a write of 1.x MSS still counts as short.
+	 */
+	if (gso_size && seg_len > gso_size)
+		seg_len = (seg_len - 1) % gso_size + 1;
+
+	if (seg_len < peers)
+		return KAT_PUSH_SHORT;
+	if (seg_len < ours)
+		return KAT_PUSH_UNCERTAIN;
+	return KAT_PUSH_NONE;
+}
+
 static void tcp_measure_rcv_mss(struct sock *sk, const struct sk_buff *skb)
 {
 	struct inet_connection_sock *icsk = inet_csk(sk);
@@ -236,6 +313,14 @@
 	 * sends good full-sized frames.
 	 */
 	len = skb_shinfo(skb)->gso_size ? : skb->len;
+	/* Only eligible, non-uplink sockets with the policy enabled pay for
+	 * classification; everyone else just clears the push class.
+	 */
+	tcp_sk(sk)->kat_short_push =
+		(icsk->icsk_ack.kat_quick_ack &&
+		 !skb->kat_from_uplink &&
+		 READ_ONCE(kat_quickack_enabled)) ?
+		kat_classify_push(sk, skb) : KAT_PUSH_NONE;
 	if (len >= icsk->icsk_ack.rcv_mss) {
 		/* Note: divides are still a bit expensive.
 		 * For the moment, only adjust scaling_ratio
@@ -1017,6 +1102,7 @@
 		}
 	}
 	icsk->icsk_ack.lrcvtime = now;
+	icsk->icsk_ack.kat_from_uplink = skb->kat_from_uplink;
 	tcp_save_lrcv_flowlabel(sk, skb);
 
 	tcp_data_ecn_check(sk, skb);
@@ -5926,7 +6012,23 @@
 static void __tcp_ack_snd_check(struct sock *sk, int ofo_possible)
 {
 	struct tcp_sock *tp = tcp_sk(sk);
+	int kat_lowat = READ_ONCE(sk->sk_rcvlowat);
+	u8 kat_lowat_push;
 	unsigned long rtt, delay;
+
+	/* Classify whether a pushed segment is waiting below SO_RCVLOWAT where
+	 * poll() cannot wake to reach __tcp_cleanup_rbuf(). Definite short
+	 * pushes (KAT_PUSH_SHORT) get one immediate ACK per unread batch;
+	 * uncertain pushes (KAT_PUSH_UNCERTAIN) and a second short push share
+	 * a single capped delayed-ACK timer per unread batch below.
+	 */
+	kat_lowat_push = (tp->kat_short_push != KAT_PUSH_NONE &&
+			  kat_lowat > 1 &&
+			  after(tp->rcv_nxt, tp->copied_seq) &&
+			  (int)(tp->rcv_nxt - tp->copied_seq) < kat_lowat &&
+			  !tcp_epollin_ready(sk, kat_lowat) &&
+			  kat_sk_wants_quickack(sk)) ?
+			 tp->kat_short_push : KAT_PUSH_NONE;
 
 	    /* More than one full frame received... */
 	if (((tp->rcv_nxt - tp->rcv_wup) > inet_csk(sk)->icsk_ack.rcv_mss &&
@@ -5940,7 +6042,14 @@
 	    /* We ACK each frame or... */
 	    tcp_in_quickack_mode(sk) ||
 	    /* Protocol state mandates a one-time immediate ACK */
-	    inet_csk(sk)->icsk_ack.pending & ICSK_ACK_NOW) {
+	    inet_csk(sk)->icsk_ack.pending & ICSK_ACK_NOW ||
+	    /* Pushed in-order data below SO_RCVLOWAT cannot wake poll() to
+	     * reach __tcp_cleanup_rbuf(); ACK the first definite short push
+	     * per unread batch immediately and cap at most one delayed ACK
+	     * below.
+	     */
+	    (kat_lowat_push == KAT_PUSH_SHORT &&
+	     !after(tp->rcv_wup, tp->copied_seq))) {
 		/* If we are running from __release_sock() in user context,
 		 * Defer the ack until tcp_release_cb().
 		 */
@@ -5956,6 +6065,25 @@
 
 	if (!ofo_possible || RB_EMPTY_ROOT(&tp->out_of_order_queue)) {
 		tcp_send_delayed_ack(sk);
+		/* Shorten, never extend, at most one pending delayed-ACK timer
+		 * per unread batch (reset on read in __tcp_cleanup_rbuf()).
+		 * That unblocks the middle write of a 3-write Nagle exchange
+		 * and an asymmetric-advmss split write while keeping stock
+		 * delayed-ACK batching for paced short-push streams.
+		 */
+		if (kat_lowat_push != KAT_PUSH_NONE &&
+		    !tp->kat_lowat_caps_used) {
+			struct inet_connection_sock *icsk = inet_csk(sk);
+			unsigned long cap = msecs_to_jiffies(4);
+			unsigned long max_timeout = jiffies + (cap ? cap - 1 : 0);
+
+			if ((icsk->icsk_ack.pending & ICSK_ACK_TIMER) &&
+			    time_after(icsk_delack_timeout(icsk), max_timeout)) {
+				sk_reset_timer(sk, &icsk->icsk_delack_timer,
+					       max_timeout);
+				tp->kat_lowat_caps_used = 1;
+			}
+		}
 		return;
 	}
 
@@ -6543,6 +6671,7 @@
 	icsk->icsk_ack.lrcvtime = tcp_jiffies32;
 
 	if (skb) {
+		icsk->icsk_ack.kat_from_uplink = skb->kat_from_uplink;
 		icsk->icsk_af_ops->sk_rx_dst_set(sk, skb);
 		security_inet_conn_established(sk, skb);
 		sk_mark_napi_id(sk, skb);
diff -ruN a/net/ipv4/tcp_minisocks.c b/net/ipv4/tcp_minisocks.c
--- a/net/ipv4/tcp_minisocks.c
+++ b/net/ipv4/tcp_minisocks.c
@@ -565,6 +565,7 @@
 		return NULL;
 
 	newicsk = inet_csk(newsk);
+	newicsk->icsk_ack.kat_from_uplink = skb->kat_from_uplink;
 	newtp = tcp_sk(newsk);
 	oldtp = tcp_sk(sk);
 
@@ -607,6 +608,10 @@
 	newtp->window_clamp = req->rsk_window_clamp;
 	newtp->rcv_ssthresh = req->rsk_rcv_wnd;
 	newtp->rcv_wnd = req->rsk_rcv_wnd;
+	/* The SYN-ACK advertised min(rsk_rcv_wnd, 65535) unscaled. */
+	newtp->kat_max_adv_win = min(req->rsk_rcv_wnd, 65535U);
+	newtp->kat_short_push = KAT_PUSH_NONE;
+	newtp->kat_lowat_caps_used = 0;
 	newtp->rx_opt.wscale_ok = ireq->wscale_ok;
 	if (newtp->rx_opt.wscale_ok) {
 		newtp->rx_opt.snd_wscale = ireq->snd_wscale;
diff -ruN a/net/ipv4/tcp_output.c b/net/ipv4/tcp_output.c
--- a/net/ipv4/tcp_output.c
+++ b/net/ipv4/tcp_output.c
@@ -195,6 +195,8 @@
 
 	if (unlikely(rcv_nxt != tp->rcv_nxt))
 		return;  /* Special ACK sent by DCTCP to reflect ECN */
+	/* Everything received so far is ACKed: no short push is pending. */
+	tp->kat_short_push = KAT_PUSH_NONE;
 	tcp_dec_quickack_mode(sk);
 	inet_csk_clear_xmit_timer(sk, ICSK_TIME_DACK);
 }
@@ -1565,13 +1567,24 @@
 
 	skb_shinfo(skb)->gso_type = sk->sk_gso_type;
 	if (likely(!(tcb->tcp_flags & TCPHDR_SYN))) {
-		th->window      = htons(tcp_select_window(sk));
+		u16 win = tcp_select_window(sk);
+
+		th->window      = htons(win);
+		/* Tracked for eligible sockets only. If a route change makes a
+		 * socket eligible later, the lower stale value only makes the
+		 * short-push estimate smaller, i.e. closer to stock behaviour.
+		 */
+		if (inet_csk(sk)->icsk_ack.kat_quick_ack)
+			tp->kat_max_adv_win = max_t(u32, tp->kat_max_adv_win,
+						    (u32)win << tp->rx_opt.rcv_wscale);
 		tcp_ecn_send(sk, skb, th, tcp_header_size);
 	} else {
 		/* RFC1323: The window in SYN & SYN/ACK segments
 		 * is never scaled.
 		 */
 		th->window	= htons(min(tp->rcv_wnd, 65535U));
+		tp->kat_max_adv_win = max_t(u32, tp->kat_max_adv_win,
+					    min(tp->rcv_wnd, 65535U));
 	}
 
 	tcp_options_write(th, tp, NULL, &opts, &key);
