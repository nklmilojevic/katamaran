Subject: [PATCH] net: avoid pingpong delayed-ACK stalls on in-VM container and bridge traffic

Keep-alive request/response traffic inside the guest can stall for a
delayed-ACK timeout (~40-50 ms at HZ=100) when a server writes response
headers and body separately without TCP_NODELAY: katamaran gives eth0 a
65520-byte MTU for gvproxy throughput and local bridges/veths inherit it,
putting response bodies up to ~64 KiB below one MSS so Nagle waits for an
ACK while the peer in pingpong mode delays it.

Setting RTAX_QUICKACK=1 by rewriting live routes from userspace has
inherent TOCTOU races with Docker/CNI gateway updates and root route
switches, and drops hidden IPv6 kernel flags and expiry state on replace.
Instead, record dst eligibility in a spare bit of icsk_ack
(kat_quick_ack) inside sk_setup_caps() when a TCP socket's resolved dst
uses a non-init network namespace (Docker containers, Kubernetes pods,
LXC machines) or a local bridge/veth device in init_net (cni0, docker0,
br-*, katbr0), leaving all routing tables untouched.

To avoid forcing extra ACKs on Internet-bound or host-bound container and
pod connections whose packets leave/enter the guest through virtio-net
(eth0), tag skbs received in virtnet_receive_done() with
skb->kat_from_uplink (preserved across __copy_skb_header,
skb_scrub_packet, IPv4/IPv6 fragmentation metadata copies in
ip_copy_metadata/ip6_copy_metadata, and fragment reassembly in
inet_frag_reasm_finish, and cleared in napi_reuse_skb) and record it on
the socket in tcp_create_openreq_child(), tcp_finish_connect(), and
tcp_event_data_recv(). In-VM traffic (pod-to-pod, ClusterIP Service DNAT,
container-to-container, root-to-bridge) never crosses virtio-net, so
kat_from_uplink stays 0.

Rather than bypassing Linux's quickack budget in tcp_in_quickack_mode()
for the lifetime of every flow (which would double pure ACK traffic on
sustained bulk transfers), lift only the pingpong suppression in
__tcp_cleanup_rbuf() when userspace drains a small or PSH-terminated
segment (ICSK_ACK_PUSHED && !sk_rmem_alloc) on an eligible non-uplink
socket with READ_ONCE(kat_quickack_enabled), and handle the matching
SO_RCVLOWAT case in __tcp_ack_snd_check() when a short pushed segment
leaves in-order data queued below sk_rcvlowat and tcp_epollin_ready() is
false. A segment is short (kat_short_push, recorded in
tcp_measure_rcv_mss() independently of the adaptive rcv_mss estimate) when
it carries PSH and its payload is below the peer's full-sized payload,
bounded by min(MSS we advertised minus negotiated options, our mss_cache);
our mss_cache already folds in the MSS the peer advertised and our path
MTU toward it. Accepted sockets record in tcp_sock.kat_advmss_ts that the
handshake already deducted the timestamp option from tp->advmss, so
options are counted once on both sides. Full-sized PSH segments keep stock
delayed-ACK batching and timers; on paths whose forward MTU alone is
narrower than both advertised MSS values, peer full-sized segments may be
classified short, which only shortens ACK delay below SO_RCVLOWAT. Then
send an immediate ACK if the previous cumulative ACK has not already covered
unread data (!after(tp->rcv_wup, tp->copied_seq)), and otherwise let
stock ACK checks run while capping any armed delayed-ACK timer to a
short non-extending deadline (accounting for the timer wheel's +1 tick
rounding so HZ=100 fires on the next 10 ms tick rather than 40-50 ms).
That unblocks split-write responses below SO_RCVLOWAT (including
multi-write sequences where the first two writes stay below SO_RCVLOWAT)
while keeping stock ACK batching for multi-segment pushed streams.
Sustained bulk streams keep stock Linux once-per-two-segments ACK pacing
and quickack budgets untouched. Toggling
/sys/module/kat/parameters/quickack at runtime takes effect immediately
for already-established sockets as well as new ones without affecting
routes that explicitly set RTAX_QUICKACK=1. Explicit locked route
metrics (RTAX_LOCK on RTAX_QUICKACK) are respected. Disable at boot with
kat.quickack=0.

SPDX-License-Identifier: GPL-2.0
---
diff -ruN a/drivers/net/virtio_net.c b/drivers/net/virtio_net.c
--- a/drivers/net/virtio_net.c
+++ b/drivers/net/virtio_net.c
@@ -2605,6 +2605,7 @@
 
 	skb_record_rx_queue(skb, vq2rxq(rq->vq));
 	skb->protocol = eth_type_trans(skb, dev);
+	skb->kat_from_uplink = 1;
 	pr_debug("Receiving skb proto 0x%04x len %i type %i\n",
 		 ntohs(skb->protocol), skb->len, skb->pkt_type);
 
diff -ruN a/include/linux/skbuff.h b/include/linux/skbuff.h
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -1032,6 +1032,7 @@
 #endif
 	__u8			unreadable:1;
 	__u8			tc_depth:2;
+	__u8			kat_from_uplink:1;
 #if defined(CONFIG_NET_SCHED) || defined(CONFIG_NET_XGRESS)
 	__u16			tc_index;	/* traffic control index */
 #endif
diff -ruN a/include/linux/tcp.h b/include/linux/tcp.h
--- a/include/linux/tcp.h
+++ b/include/linux/tcp.h
@@ -294,7 +294,8 @@
 	u8	nonagle     : 4,/* Disable Nagle algorithm?             */
 		rate_app_limited:1;  /* rate_{delivered,interval_us} limited? */
 	u8	received_ce_pending:4, /* Not yet transmit cnt of received_ce */
-		unused2:4;
+		kat_advmss_ts:1, /* advmss already excludes TCP timestamps */
+		unused2:3;
 	u8	accecn_minlen:2,/* Minimum length of AccECN option sent */
 		est_ecnfield:2,/* ECN field for AccECN delivered estimates */
 		accecn_opt_demand:2,/* Demand AccECN option for n next ACKs */
diff -ruN a/include/net/inet_connection_sock.h b/include/net/inet_connection_sock.h
--- a/include/net/inet_connection_sock.h
+++ b/include/net/inet_connection_sock.h
@@ -119,7 +119,9 @@
 		__u32		  ato:ATO_BITS,	 /* Predicted tick of soft clock	   */
 				  lrcv_flowlabel:20, /* last received ipv6 flowlabel	   */
 				  dst_quick_ack:1, /* cache dst RTAX_QUICKACK		   */
-				  unused:3;
+				  kat_quick_ack:1, /* eligible local container/bridge dst  */
+				  kat_from_uplink:1, /* last rx segment came via virtio_net */
+				  kat_short_push:1; /* last rx data: short PSH write	   */
 		__u32		  lrcvtime;	 /* timestamp of last received data packet */
 		__u16		  last_seg_size; /* Size of last incoming segment	   */
 		__u16		  rcv_mss;	 /* MSS used for delayed ACK decisions	   */
@@ -273,6 +275,17 @@
 struct sock *inet_csk_reqsk_queue_add(struct sock *sk,
 				      struct request_sock *req,
 				      struct sock *child);
+extern bool kat_quickack_enabled;
+
+static inline bool kat_sk_wants_quickack(const struct sock *sk)
+{
+	const struct inet_connection_sock *icsk = inet_csk(sk);
+
+	return icsk->icsk_ack.kat_quick_ack &&
+	       !icsk->icsk_ack.kat_from_uplink &&
+	       READ_ONCE(kat_quickack_enabled);
+}
+
 bool inet_csk_reqsk_queue_hash_add(struct sock *sk, struct request_sock *req,
 				   unsigned long timeout);
 struct sock *inet_csk_complete_hashdance(struct sock *sk, struct sock *child,
diff -ruN a/net/core/gro.c b/net/core/gro.c
--- a/net/core/gro.c
+++ b/net/core/gro.c
@@ -691,6 +691,7 @@
 		skb_ext_reset(skb);
 		nf_reset_ct(skb);
 		skb->slow_gro = 0;
+		skb->kat_from_uplink = 0;
 	}
 
 	napi->skb = skb;
diff -ruN a/net/core/sock.c b/net/core/sock.c
--- a/net/core/sock.c
+++ b/net/core/sock.c
@@ -126,6 +126,7 @@
 #include <linux/skbuff.h>
 #include <linux/skbuff_ref.h>
 #include <net/net_namespace.h>
+#include <net/rtnetlink.h>
 #include <net/request_sock.h>
 #include <net/sock.h>
 #include <net/proto_memory.h>
@@ -2608,6 +2609,21 @@
 	return max_size - (MAX_TCP_HEADER + 1);
 }
 
+bool kat_quickack_enabled __read_mostly = true;
+EXPORT_SYMBOL_GPL(kat_quickack_enabled);
+__module_param_call("kat.", quickack, &param_ops_bool,
+		    &kat_quickack_enabled, 0644, -1, 0);
+
+static bool kat_dev_wants_quickack(const struct net_device *dev)
+{
+	if (!net_eq(dev_net(dev), &init_net))
+		return true;
+	if (netif_is_bridge_master(dev))
+		return true;
+	return dev->rtnl_link_ops && dev->rtnl_link_ops->kind &&
+	       strcmp(dev->rtnl_link_ops->kind, "veth") == 0;
+}
+
 void sk_setup_caps(struct sock *sk, struct dst_entry *dst)
 {
 	const struct net_device *dev;
@@ -2621,6 +2637,9 @@
 
 		sk->sk_route_caps |= NETIF_F_GSO;
 		icsk->icsk_ack.dst_quick_ack = dst_metric(dst, RTAX_QUICKACK);
+		icsk->icsk_ack.kat_quick_ack =
+			!dst_metric_locked(dst, RTAX_QUICKACK) &&
+			kat_dev_wants_quickack(dev);
 	}
 	if (sk->sk_route_caps & NETIF_F_GSO)
 		sk->sk_route_caps |= NETIF_F_GSO_SOFTWARE;
diff -ruN a/net/ipv4/inet_fragment.c b/net/ipv4/inet_fragment.c
--- a/net/ipv4/inet_fragment.c
+++ b/net/ipv4/inet_fragment.c
@@ -645,6 +645,7 @@
 			int delta;
 
 			sum_truesize += fp->truesize;
+			head->kat_from_uplink |= fp->kat_from_uplink;
 			if (head->ip_summed != fp->ip_summed)
 				head->ip_summed = CHECKSUM_NONE;
 			else if (head->ip_summed == CHECKSUM_COMPLETE)
diff -ruN a/net/ipv4/ip_output.c b/net/ipv4/ip_output.c
--- a/net/ipv4/ip_output.c
+++ b/net/ipv4/ip_output.c
@@ -555,6 +555,7 @@
 	to->priority = from->priority;
 	to->protocol = from->protocol;
 	to->skb_iif = from->skb_iif;
+	to->kat_from_uplink = from->kat_from_uplink;
 	skb_dst_drop(to);
 	skb_dst_copy(to, from);
 	to->dev = from->dev;
diff -ruN a/net/ipv4/tcp.c b/net/ipv4/tcp.c
--- a/net/ipv4/tcp.c
+++ b/net/ipv4/tcp.c
@@ -1531,7 +1531,8 @@
 		    (copied > 0 &&
 		     ((icsk->icsk_ack.pending & ICSK_ACK_PUSHED2) ||
 		      ((icsk->icsk_ack.pending & ICSK_ACK_PUSHED) &&
-		       !inet_csk_in_pingpong_mode(sk))) &&
+		       (!inet_csk_in_pingpong_mode(sk) ||
+			kat_sk_wants_quickack(sk)))) &&
 		      !atomic_read(&sk->sk_rmem_alloc)))
 			time_to_ack = true;
 	}
diff -ruN a/net/ipv4/tcp_input.c b/net/ipv4/tcp_input.c
--- a/net/ipv4/tcp_input.c
+++ b/net/ipv4/tcp_input.c
@@ -224,6 +224,47 @@
 /* Adapt the MSS value used to make delayed ack decision to the
  * real world.
  */
+/* Is this a PSH segment shorter than the peer's full-sized segments, i.e.
+ * the end of a sub-MSS application write whose remainder the peer's Nagle
+ * may be holding until we ACK?
+ *
+ * The peer sends full-sized segments of its mss_cache payload, which is
+ * min(MSS we advertised, its path MSS toward us) minus TCP options. The
+ * adaptive rcv_mss estimate cannot stand in for it: repeated small writes
+ * settle rcv_mss at their own size although they are still sub-MSS for the
+ * sender. Instead bound the peer's full payload from both sides:
+ *
+ *  - the MSS we advertised in our SYN/SYN-ACK, minus negotiated options.
+ *    Accepted connections already had the timestamp option deducted from
+ *    tp->advmss when entering ESTABLISHED (kat_advmss_ts); connections we
+ *    opened did not. Add it back so options are counted exactly once.
+ *  - tp->mss_cache: our own send MSS, already min(MSS the peer advertised,
+ *    our path MSS toward the peer) minus options. The peer's advertised MSS
+ *    reflects its interface MTU, and on the symmetric in-VM paths this
+ *    policy covers (veth/bridge hops inside the guest, never the virtio-net
+ *    uplink) our path MTU toward the peer equals its path MTU toward us.
+ *
+ * Asymmetric MTU: if the peer's outbound path is narrower than both what we
+ * advertised and what it advertised (e.g. its interface MTU exceeds that of
+ * a forward-only hop), its full-sized segments fall below this limit unless
+ * the reverse path shares that hop, and are treated as short. The cost is
+ * bounded: only while data sits below SO_RCVLOWAT, at most one immediate
+ * ACK per unread batch, otherwise the delayed-ACK timer is only shortened,
+ * so ACK frequency is at most one per timer tick for such segments.
+ */
+static bool kat_is_short_push(const struct sock *sk, const struct sk_buff *skb,
+			      unsigned int seg_len)
+{
+	const struct tcp_sock *tp = tcp_sk(sk);
+	unsigned int opts = tp->tcp_header_len - sizeof(struct tcphdr);
+	unsigned int adv = tp->advmss +
+			   (tp->kat_advmss_ts ? TCPOLEN_TSTAMP_ALIGNED : 0);
+	unsigned int full = adv > opts ? adv - opts : 0;
+
+	full = min_t(unsigned int, full, tp->mss_cache);
+	return (TCP_SKB_CB(skb)->tcp_flags & TCPHDR_PSH) && seg_len < full;
+}
+
 static void tcp_measure_rcv_mss(struct sock *sk, const struct sk_buff *skb)
 {
 	struct inet_connection_sock *icsk = inet_csk(sk);
@@ -236,6 +277,7 @@
 	 * sends good full-sized frames.
 	 */
 	len = skb_shinfo(skb)->gso_size ? : skb->len;
+	icsk->icsk_ack.kat_short_push = kat_is_short_push(sk, skb, len);
 	if (len >= icsk->icsk_ack.rcv_mss) {
 		/* Note: divides are still a bit expensive.
 		 * For the moment, only adjust scaling_ratio
@@ -1017,6 +1059,7 @@
 		}
 	}
 	icsk->icsk_ack.lrcvtime = now;
+	icsk->icsk_ack.kat_from_uplink = skb->kat_from_uplink;
 	tcp_save_lrcv_flowlabel(sk, skb);
 
 	tcp_data_ecn_check(sk, skb);
@@ -5926,8 +5969,20 @@
 static void __tcp_ack_snd_check(struct sock *sk, int ofo_possible)
 {
 	struct tcp_sock *tp = tcp_sk(sk);
+	bool kat_lowat_pushed;
 	unsigned long rtt, delay;
 
+	/* Only a short pushed segment (see kat_is_short_push()) can be a
+	 * sub-MSS write the peer's Nagle is waiting on; full-sized PSH
+	 * segments keep stock delayed-ACK batching and timers.
+	 */
+	kat_lowat_pushed = inet_csk(sk)->icsk_ack.kat_short_push &&
+			   sk->sk_rcvlowat > 1 &&
+			   after(tp->rcv_nxt, tp->copied_seq) &&
+			   (int)(tp->rcv_nxt - tp->copied_seq) < sk->sk_rcvlowat &&
+			   !tcp_epollin_ready(sk, sk->sk_rcvlowat) &&
+			   kat_sk_wants_quickack(sk);
+
 	    /* More than one full frame received... */
 	if (((tp->rcv_nxt - tp->rcv_wup) > inet_csk(sk)->icsk_ack.rcv_mss &&
 	     /* ... and right edge of window advances far enough.
@@ -5940,7 +5995,12 @@
 	    /* We ACK each frame or... */
 	    tcp_in_quickack_mode(sk) ||
 	    /* Protocol state mandates a one-time immediate ACK */
-	    inet_csk(sk)->icsk_ack.pending & ICSK_ACK_NOW) {
+	    inet_csk(sk)->icsk_ack.pending & ICSK_ACK_NOW ||
+	    /* Pushed in-order data below SO_RCVLOWAT cannot wake poll() to
+	     * reach __tcp_cleanup_rbuf(); ACK the first segment per unread
+	     * batch immediately and cap later ones below.
+	     */
+	    (kat_lowat_pushed && !after(tp->rcv_wup, tp->copied_seq))) {
 		/* If we are running from __release_sock() in user context,
 		 * Defer the ack until tcp_release_cb().
 		 */
@@ -5956,6 +6016,16 @@
 
 	if (!ofo_possible || RB_EMPTY_ROOT(&tp->out_of_order_queue)) {
 		tcp_send_delayed_ack(sk);
+		if (kat_lowat_pushed) {
+			struct inet_connection_sock *icsk = inet_csk(sk);
+			unsigned long cap = msecs_to_jiffies(4);
+			unsigned long max_timeout = jiffies + (cap ? cap - 1 : 0);
+
+			if ((icsk->icsk_ack.pending & ICSK_ACK_TIMER) &&
+			    time_after(icsk_delack_timeout(icsk), max_timeout))
+				sk_reset_timer(sk, &icsk->icsk_delack_timer,
+					       max_timeout);
+		}
 		return;
 	}
 
@@ -6543,6 +6613,7 @@
 	icsk->icsk_ack.lrcvtime = tcp_jiffies32;
 
 	if (skb) {
+		icsk->icsk_ack.kat_from_uplink = skb->kat_from_uplink;
 		icsk->icsk_af_ops->sk_rx_dst_set(sk, skb);
 		security_inet_conn_established(sk, skb);
 		sk_mark_napi_id(sk, skb);
@@ -7054,8 +7125,10 @@
 		if (!tp->srtt_us)
 			tcp_synack_rtt_meas(sk, req);
 
-		if (tp->rx_opt.tstamp_ok)
+		if (tp->rx_opt.tstamp_ok) {
 			tp->advmss -= TCPOLEN_TSTAMP_ALIGNED;
+			tp->kat_advmss_ts = 1;
+		}
 
 		if (req) {
 			tcp_rcv_synrecv_state_fastopen(sk);
diff -ruN a/net/ipv4/tcp_minisocks.c b/net/ipv4/tcp_minisocks.c
--- a/net/ipv4/tcp_minisocks.c
+++ b/net/ipv4/tcp_minisocks.c
@@ -565,6 +565,7 @@
 		return NULL;
 
 	newicsk = inet_csk(newsk);
+	newicsk->icsk_ack.kat_from_uplink = skb->kat_from_uplink;
 	newtp = tcp_sk(newsk);
 	oldtp = tcp_sk(sk);
 
diff -ruN a/net/ipv6/ip6_output.c b/net/ipv6/ip6_output.c
--- a/net/ipv6/ip6_output.c
+++ b/net/ipv6/ip6_output.c
@@ -696,6 +696,7 @@
 	to->pkt_type = from->pkt_type;
 	to->priority = from->priority;
 	to->protocol = from->protocol;
+	to->kat_from_uplink = from->kat_from_uplink;
 	skb_dst_drop(to);
 	skb_dst_set(to, dst_clone(skb_dst(from)));
 	to->dev = from->dev;
