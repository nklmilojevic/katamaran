diff -ruN a/include/linux/kat_fsnotify.h b/include/linux/kat_fsnotify.h
--- a/include/linux/kat_fsnotify.h	1970-01-01 01:00:00
+++ b/include/linux/kat_fsnotify.h	2026-11-18 13:24:28
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * katamaran: file changes made on the host, raised in the guest.
+ *
+ * /dev/kat_fsnotify is opened by the guest agent only. Reading it yields
+ * struct kat_fsn_report records: the virtio-fs inodes guest processes watch
+ * with inotify, so the host watches the same files. Writing it takes
+ * struct kat_fsn_event records: changes the host saw, which raise the
+ * fsnotify events a local change would and drop the guest's cached
+ * attributes, data and dentries for the changed files.
+ *
+ * Both record kinds are padded to a multiple of 8 bytes; `len` (reports) or
+ * the header plus `name_len` rounded up (events) gives the stride.
+ */
+#ifndef _LINUX_KAT_FSNOTIFY_H
+#define _LINUX_KAT_FSNOTIFY_H
+
+#include <linux/types.h>
+
+/* report types */
+#define KAT_FSN_WATCH		1	/* id, dev, path: a new watched inode */
+#define KAT_FSN_UNWATCH		2	/* id: no longer watched */
+#define KAT_FSN_RESET		3	/* forget every id; WATCH records follow */
+
+/* report and event flags */
+#define KAT_FSN_ISDIR		0x1
+
+struct kat_fsn_report {
+	__u32 len;
+	__u16 type;
+	__u16 flags;
+	__u64 id;
+	__u64 dev;		/* st_dev of the virtio-fs mount */
+	__u32 path_len;
+	__u32 reserved;
+	char path[];		/* below the mount's root, starts with '/' */
+};
+
+/* event ops */
+#define KAT_FSN_CREATE		1
+#define KAT_FSN_DELETE		2
+#define KAT_FSN_MODIFY		3
+#define KAT_FSN_ATTRIB		4
+#define KAT_FSN_MOVED_FROM	5
+#define KAT_FSN_MOVED_TO	6
+
+/*
+ * A change to the child `name` of watched directory `id`, or to the watched
+ * inode itself when name_len is 0. `ino` is the host inode number of the
+ * object the change is about (the removed one for DELETE and MOVED_FROM),
+ * 0 if unknown; a cached entry for a different object is left alone.
+ */
+struct kat_fsn_event {
+	__u64 id;
+	__u64 ino;
+	__u32 cookie;
+	__u16 op;
+	__u8 flags;
+	__u8 name_len;
+	char name[];
+};
+
+#ifdef __KERNEL__
+struct inode;
+#if IS_BUILTIN(CONFIG_FUSE_FS) && IS_BUILTIN(CONFIG_VIRTIO_FS)
+bool kat_fsnotify_watch(struct inode *inode);
+void kat_fsnotify_unwatch(struct inode *inode);
+#else
+static inline bool kat_fsnotify_watch(struct inode *inode) { return false; }
+static inline void kat_fsnotify_unwatch(struct inode *inode) { }
+#endif
+#endif /* __KERNEL__ */
+
+#endif /* _LINUX_KAT_FSNOTIFY_H */
