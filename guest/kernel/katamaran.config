# katamaran guest kernel fragment (arm64), applied as
#   make allnoconfig KCONFIG_ALLCONFIG=katamaran.config && make olddefconfig
# Anything not listed is off: boot time is spent per enabled initcall. Every `=<value>` line
# below must survive into .config (build.sh fails with MISSING: otherwise) and every
# `is not set` line must stay off (UNWANTED:). EXPERT stays off, so options that are only
# hideable under EXPERT (MULTIUSER, PRINTK, FUTEX, EPOLL, ...) keep their default y; the
# important ones are still listed so the check guards them.

# --- Build shape ---------------------------------------------------------------------------
# Everything built in; no module loader in the guest.
# CONFIG_MODULES is not set
# No KASLR: libkrun loads the raw Image at a fixed address and it saves boot work.
# CONFIG_RANDOMIZE_BASE is not set
# The initramfs is an uncompressed newc cpio, so no decompressors are needed.
CONFIG_BLK_DEV_INITRD=y
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# No module signing, no debug info, no ftrace/kprobes.
# CONFIG_DEBUG_INFO is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# Readable panics and printk timestamps for boot analysis; /proc/config.gz for check-config.
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_JUMP_LABEL=y

# --- CPU, scheduler, timers ----------------------------------------------------------------
CONFIG_SMP=y
# Largest Apple Silicon parts have 32 cores; keeps per-CPU arrays small.
CONFIG_NR_CPUS=64
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# Apple cores: LSE atomics, hardware AF/DBM, PAN, pointer auth. No SVE/SME/MTE on Apple
# Silicon; AArch32 userspace cannot run there, so no COMPAT.
CONFIG_ARM64_USE_LSE_ATOMICS=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_HW_AFDBM=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_EPAN=y
CONFIG_ARM64_CNP=y
CONFIG_ARM64_TLB_RANGE=y
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_TAGGED_ADDR_ABI=y
# CONFIG_COMPAT is not set
# CONFIG_ARM64_SVE is not set
# KPTI (UNMAP_KERNEL_AT_EL0) can only be compiled out with EXPERT; it stays built in, and the
# kernel enables it only on CPUs that do not report CSV3 (or never, with kpti=0).
# Preemption: voluntary. Explicit preemption points give interactive shells good latency
# without the preempt_count cost of PREEMPT/PREEMPT_LAZY; dockerd/builds are throughput work.
CONFIG_PREEMPT_VOLUNTARY=y
# Do not zero every stack variable on function entry (-ftrivial-auto-var-init=zero).
CONFIG_INIT_STACK_NONE=y
# HZ=100 (as libkrunfw): every tick on a busy vCPU is a vtimer exit through Hypervisor.framework
# and an injection through libkrun's GIC, so fewer ticks means less host overhead. Idle vCPUs
# do not tick at all (NO_HZ_IDLE); sleeps and timeouts still use high-resolution timers.
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# --- Platform: libkrun aarch64 hvf machine -------------------------------------------------
# FDT only ("linux,dummy-virt"): no ACPI, no EFI stub, no PCI (devices are virtio-mmio).
# CONFIG_ACPI is not set
# CONFIG_EFI is not set
# CONFIG_PCI is not set
# GICv3 (libkrun's emulated gicv3 or macOS's in-kernel hvf GIC; both "arm,gic-v3"), ARM
# architected timer, PSCI 0.2 (libkrun's FDT says method "smc" on macOS; HVC is trapped too).
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y
CONFIG_ARM_AMBA=y
# PL011 UART (when libkrun is given a serial console; also usable as earlycon=pl011,<addr>).
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
# PL031 RTC (always registered by libkrun on macOS); sets the clock at boot.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_PL031=y
# PL061 GPIO + gpio-keys: libkrun's shutdown eventfd raises KEY_RESTART on /dev/input/event0
# so PID 1 can do an orderly poweroff on a host request.
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y

# --- virtio (MMIO transport, version 2) ----------------------------------------------------
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
# Console on hvc0.
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
# Balloon with free page reporting and balloon page compaction.
CONFIG_VIRTIO_BALLOON=y
CONFIG_MEMORY_BALLOON=y
CONFIG_BALLOON_COMPACTION=y
CONFIG_PAGE_REPORTING=y
# Entropy from the host so getrandom() does not block early in boot.
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# vsock (virtio transport) for the control channel.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# virtio-fs (FUSE). No DAX window: it needs ZONE_DEVICE/FS_DAX and memory hotplug.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# --- Block ---------------------------------------------------------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
# The data disk is GPT.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
# CONFIG_MSDOS_PARTITION is not set

# --- Filesystems ---------------------------------------------------------------------------
# devtmpfs is mounted by kat-init, not by the kernel.
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# Read-only system rootfs; lz4 is EROFS's default compressor.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_FHANDLE=y
# CONFIG_AUTOFS_FS is not set

# --- Syscalls and process features ---------------------------------------------------------
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_CROSS_MEMORY_ATTACH=y
# kcmp and /proc/<pid>/children (systemd in machines, CRIU).
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_COREDUMP=y

# --- Containers: namespaces, cgroup v2, seccomp, BPF, keys ---------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_TIME_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
# The cgroup v2 freezer is built in; CGROUP_FREEZER (v1) is listed by moby's check-config.
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
# Device control on cgroup v2 is a BPF program; CGROUP_DEVICE is listed by check-config.
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_KEYS=y

# --- Memory and observability --------------------------------------------------------------
CONFIG_SLUB_CPU_PARTIAL=y
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_PSI=y
# CONFIG_PSI_DEFAULT_DISABLED is not set
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_COMPACTION=y
CONFIG_MIGRATION=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# zram (zsmalloc backend) with LZ4: compressed in-RAM swap sized to guest RAM,
# zero memory when idle, no disk I/O, and immediate discard when pages free.
# Keep zswap off so pages swapped to zram are not compressed twice.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# CONFIG_ZSWAP is not set

# --- Networking core -----------------------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
# sock_diag: listening-socket discovery for automatic port forwarding, and `ss`.
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
# No sit0/ip6tnl0 in every network namespace.
# CONFIG_IPV6_SIT is not set
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
CONFIG_BRIDGE=y
# CONFIG_VXLAN is not set

# --- Netfilter: nftables + iptables-nft (xtables) for dockerd ------------------------------
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
# dockerd flushes conntrack entries over netlink when port mappings change.
CONFIG_NF_CT_NETLINK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FWD_NETDEV=y
# iptables-nft runs xtables matches/targets inside nftables rules.
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_IPRANGE=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_PHYSDEV=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=y
# IPVS core only: xt_ipvs is in check-config's "Generally Necessary" and depends on it.
# No schedulers or protocol handlers (swarm-mode load balancing is out of scope).
CONFIG_IP_VS=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
# Since 6.17 the filter/nat/mangle/raw tables are "legacy" xtables. iptables-nft does not need
# them, but moby's check-config lists them as Generally Necessary, and they cover
# iptables-legacy users inside containers and machines.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
