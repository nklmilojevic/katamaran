+/// Gives the pages of a range that isn't reclaimed back to the host.
+///
+/// XNU ignores madvise() for pages that the guest faulted in while the hypervisor maps them: they
+/// stay dirty and in the footprint, and the system can't take them. So the range is unmapped from
+/// the guest first and mapped again afterwards, which the guest doesn't notice: it doesn't touch
+/// reported pages before the report is used. MADV_FREE then takes the pages out of the footprint,
+/// and a later access by the guest counts them again. MADV_FREE_REUSABLE doesn't: the pages that
+/// the guest writes to again stay out of the footprint until memory pressure makes the system
+/// account for them, so the footprint keeps growing after each pressure spike.
+///
+/// Without the hypervisor (in the tests), the pages are madvise()d with MADV_FREE_REUSABLE, which
+/// takes the pages that the VMM itself wrote to out of the footprint.
+fn release_pages(range: &FreeRange) {
+    let guest_addr = range.guest_addr.0;
+    // SAFETY: the range is guest memory, whose contents the guest has given up.
+    let unmapped = unsafe { hv_vm_unmap(guest_addr, range.len) } == HV_SUCCESS as hv_return_t;
+    let advice = if unmapped {
+        libc::MADV_FREE
+    } else {
+        libc::MADV_FREE_REUSABLE
+    };
+    // SAFETY: as above.
+    unsafe { libc::madvise(range.host_addr.cast(), range.len, advice) };
+    if !unmapped {
+        return;
+    }
+    let flags = HV_MEMORY_READ | HV_MEMORY_WRITE | HV_MEMORY_EXEC;
+    // SAFETY: maps the range of guest memory back where it was.
+    let ret = unsafe { hv_vm_map(range.host_addr.cast(), guest_addr, range.len, flags.into()) };
+    if ret != HV_SUCCESS as hv_return_t {
+        error!(
+            "balloon: couldn't map guest memory back: guest_addr={guest_addr:x} len={} ret={ret:x}",
+            range.len
+        );
+    }
+}
