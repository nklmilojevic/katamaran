+                    inode,
+                    ino: st.st_ino,
+                    dev: st.st_dev,
+                    refcount: AtomicU64::new(1),
+                    unlinked_fd: AtomicI64::new(-1),
+                    read_only_file: Mutex::new(Weak::new()),
+                }),
+            );
