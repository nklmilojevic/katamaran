+        let mut out = Out { len: 0, id: 0 };
+        let c = CString::new(path.as_os_str().as_bytes()).unwrap();
+        let r = unsafe {
+            libc::getattrlist(
+                c.as_ptr(),
+                (&al as *const AttrList).cast_mut().cast(),
+                (&mut out as *mut Out).cast(),
+                std::mem::size_of::<Out>(),
