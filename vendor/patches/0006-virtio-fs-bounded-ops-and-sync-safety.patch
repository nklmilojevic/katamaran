+        #[repr(C, packed)]
+        struct Out {
+            len: u32,
+            id: u64,
+        }
+        const ATTR_BIT_MAP_COUNT: u16 = 5;
+        const ATTR_CMNEXT_CLONEID: u32 = 0x0000_0100;
+        const FSOPT_ATTR_CMN_EXTENDED: u32 = 0x0000_0020;
+        let al = AttrList {
+            bitmapcount: ATTR_BIT_MAP_COUNT,
+            reserved: 0,
+            commonattr: 0,
+            volattr: 0,
+            dirattr: 0,
+            fileattr: 0,
+            forkattr: ATTR_CMNEXT_CLONEID,
