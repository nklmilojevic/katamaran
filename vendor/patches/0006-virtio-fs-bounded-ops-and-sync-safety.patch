+            .open(&dp)
+            .unwrap();
+        std::fs::set_permissions(&dp, std::os::unix::fs::PermissionsExt::from_mode(0o640)).unwrap();
+        let k = CString::new("user.containers.override_stat").unwrap();
+        let v = b"0:0:0100644";
+        assert_eq!(
