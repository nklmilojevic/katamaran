diff --git a/src/devices/src/virtio/fs/macos/boundaries.rs b/src/devices/src/virtio/fs/macos/boundaries.rs
new file mode 100644
index 00000000..5d1ef203
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/boundaries.rs
@@ -0,0 +1,315 @@
+//! Mount boundaries: which volumes are safe to touch on a vCPU thread.
+//!
+//! Only local APFS and HFS volumes are safe. Network filesystems, FUSE
+//! (macFUSE, fuse-t), autofs and other exotic volumes can block for as long
+//! as their server takes, so nodes on them are async-only, and lookups of
+//! their mountpoints are too. The table comes from `getfsstat` and is rebuilt
+//! whenever the kernel reports a mount change (kqueue `EVFILT_FS`), or when a
+//! lookup meets a device that is not in it.
+
+use std::collections::HashMap;
+use std::ffi::CStr;
+use std::io;
+use std::mem::MaybeUninit;
+use std::os::unix::ffi::OsStrExt;
+use std::path::Path;
+use std::sync::{Arc, Mutex, OnceLock, RwLock};
+use std::thread;
+use std::time::{Duration, Instant};
+
+use super::super::sync_policy::Boundaries;
+
+/// One mounted volume.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Mount {
+    /// `f_fsid.val[0]`, which is the `st_dev` of files on the volume.
+    pub dev: u64,
+    pub fstype: String,
+    pub path: Vec<u8>,
+    pub local: bool,
+}
+
+impl Mount {
+    pub fn is_safe(&self) -> bool {
+        self.local && matches!(self.fstype.as_str(), "apfs" | "hfs")
+    }
+}
+
+/// Safe devices plus, for each directory that holds unsafe mountpoints, the
+/// names of those mountpoints.
+#[derive(Debug, Default)]
+pub struct MountTable {
+    safe: HashMap<u64, bool>,
+    parents: HashMap<(u64, u64), Vec<Vec<u8>>>,
+}
+
+impl MountTable {
+    /// `stat_dir` returns (dev, ino) of a directory path.
+    pub fn build(mounts: &[Mount], stat_dir: impl Fn(&[u8]) -> Option<(u64, u64)>) -> Self {
+        let mut t = MountTable::default();
+        for m in mounts {
+            // A device mounted twice is only safe if every instance is.
+            let safe = t.safe.entry(m.dev).or_insert(true);
+            *safe &= m.is_safe();
+        }
+        for m in mounts.iter().filter(|m| !m.is_safe()) {
+            let path = Path::new(std::ffi::OsStr::from_bytes(&m.path));
+            let (Some(parent), Some(name)) = (path.parent(), path.file_name()) else {
+                continue;
+            };
+            if let Some(key) = stat_dir(parent.as_os_str().as_bytes()) {
+                t.parents
+                    .entry(key)
+                    .or_default()
+                    .push(name.as_bytes().to_vec());
+            }
+        }
+        t
+    }
+
+    /// `None` when the device is not in the table.
+    pub fn dev_safe(&self, dev: u64) -> Option<bool> {
+        self.safe.get(&dev).copied()
+    }
+
+    pub fn is_boundary_parent(&self, dev: u64, ino: u64) -> bool {
+        self.parents.contains_key(&(dev, ino))
+    }
+
+    pub fn is_unsafe_mountpoint(&self, dev: u64, ino: u64, name: &[u8]) -> bool {
+        self.parents
+            .get(&(dev, ino))
+            .is_some_and(|names| names.iter().any(|n| n == name))
+    }
+}
+
+fn cstr_field(buf: &[libc::c_char]) -> &[u8] {
+    // SAFETY: getfsstat NUL-terminates these fixed-size fields.
+    unsafe { CStr::from_ptr(buf.as_ptr()) }.to_bytes()
+}
+
+/// `f_fsid.val[0]`; libc keeps the field private.
+fn fsid_dev(fsid: &libc::fsid_t) -> u64 {
+    // SAFETY: fsid_t is two int32_t on macOS.
+    let val: [i32; 2] = unsafe { std::mem::transmute_copy(fsid) };
+    val[0] as u32 as u64
+}
+
+/// The current mounts, without waiting for unresponsive volumes.
+pub fn enumerate() -> io::Result<Vec<Mount>> {
+    loop {
+        let n = unsafe { libc::getfsstat(std::ptr::null_mut(), 0, libc::MNT_NOWAIT) };
+        if n < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let cap = n as usize + 4;
+        let mut buf: Vec<libc::statfs> = Vec::with_capacity(cap);
+        let size = (cap * std::mem::size_of::<libc::statfs>()) as libc::c_int;
+        let got = unsafe { libc::getfsstat(buf.as_mut_ptr(), size, libc::MNT_NOWAIT) };
+        if got < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        if got as usize == cap {
+            continue;
+        }
+        unsafe { buf.set_len(got as usize) };
+        return Ok(buf
+            .iter()
+            .map(|s| Mount {
+                dev: fsid_dev(&s.f_fsid),
+                fstype: String::from_utf8_lossy(cstr_field(&s.f_fstypename)).into_owned(),
+                path: cstr_field(&s.f_mntonname).to_vec(),
+                local: s.f_flags & libc::MNT_LOCAL as u32 != 0,
+            })
+            .collect());
+    }
+}
+
+fn lstat_dir(path: &[u8]) -> Option<(u64, u64)> {
+    let c = std::ffi::CString::new(path).ok()?;
+    let mut st = MaybeUninit::<libc::stat>::zeroed();
+    if unsafe { libc::lstat(c.as_ptr(), st.as_mut_ptr()) } != 0 {
+        return None;
+    }
+    let st = unsafe { st.assume_init() };
+    Some((st.st_dev as u32 as u64, st.st_ino))
+}
+
+/// The host's mount boundaries, kept current by a watcher thread.
+pub struct MountBoundaries {
+    table: RwLock<Arc<MountTable>>,
+    last_rebuild: Mutex<Instant>,
+}
+
+/// Unknown devices trigger at most one rebuild per this interval.
+const REBUILD_INTERVAL: Duration = Duration::from_secs(1);
+
+impl MountBoundaries {
+    /// The process-wide instance; the first call builds the table and starts
+    /// the watcher.
+    pub fn shared() -> Arc<MountBoundaries> {
+        static B: OnceLock<Arc<MountBoundaries>> = OnceLock::new();
+        B.get_or_init(|| {
+            let b = Arc::new(MountBoundaries {
+                table: RwLock::new(Arc::new(MountTable::default())),
+                last_rebuild: Mutex::new(Instant::now()),
+            });
+            b.rebuild();
+            let w = b.clone();
+            let _ = thread::Builder::new()
+                .name("fs mounts".into())
+                .spawn(move || w.watch());
+            b
+        })
+        .clone()
+    }
+
+    fn rebuild(&self) {
+        match enumerate() {
+            Ok(mounts) => {
+                let t = MountTable::build(&mounts, lstat_dir);
+                debug!(
+                    "rebuilt unsafe mount boundaries: {} volumes, {} boundary dirs",
+                    t.safe.len(),
+                    t.parents.len()
+                );
+                *self.table.write().unwrap() = Arc::new(t);
+            }
+            Err(e) => warn!("failed to enumerate mounts: {e}"),
+        }
+        *self.last_rebuild.lock().unwrap() = Instant::now();
+    }
+
+    fn table(&self) -> Arc<MountTable> {
+        self.table.read().unwrap().clone()
+    }
+
+    fn watch(&self) {
+        let kq = unsafe { libc::kqueue() };
+        if kq < 0 {
+            warn!("mount watcher: kqueue: {}", io::Error::last_os_error());
+            return;
+        }
+        let mut ev: libc::kevent = unsafe { std::mem::zeroed() };
+        ev.filter = libc::EVFILT_FS;
+        ev.flags = libc::EV_ADD | libc::EV_CLEAR;
+        if unsafe { libc::kevent(kq, &ev, 1, std::ptr::null_mut(), 0, std::ptr::null()) } < 0 {
+            warn!("mount watcher: EVFILT_FS: {}", io::Error::last_os_error());
+            return;
+        }
+        loop {
+            let mut out: libc::kevent = unsafe { std::mem::zeroed() };
+            let n = unsafe { libc::kevent(kq, std::ptr::null(), 0, &mut out, 1, std::ptr::null()) };
+            if n > 0 {
+                // Mounts often come in bursts (a disk image with several volumes).
+                thread::sleep(Duration::from_millis(50));
+                self.rebuild();
+            }
+        }
+    }
+}
+
+impl Boundaries for MountBoundaries {
+    fn is_safe_dev(&self, dev: u64) -> bool {
+        if let Some(safe) = self.table().dev_safe(dev) {
+            return safe;
+        }
+        if self.last_rebuild.lock().unwrap().elapsed() >= REBUILD_INTERVAL {
+            self.rebuild();
+        }
+        self.table().dev_safe(dev).unwrap_or(false)
+    }
+
+    fn is_boundary_parent(&self, dev: u64, ino: u64) -> bool {
+        self.table().is_boundary_parent(dev, ino)
+    }
+
+    fn is_unsafe_mountpoint(&self, dev: u64, ino: u64, name: &[u8]) -> bool {
+        self.table().is_unsafe_mountpoint(dev, ino, name)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn m(dev: u64, fstype: &str, path: &str, local: bool) -> Mount {
+        Mount {
+            dev,
+            fstype: fstype.into(),
+            path: path.as_bytes().to_vec(),
+            local,
+        }
+    }
+
+    #[test]
+    fn safe_volumes() {
+        assert!(m(1, "apfs", "/", true).is_safe());
+        assert!(m(2, "hfs", "/Volumes/Old", true).is_safe());
+        assert!(!m(3, "nfs", "/Users/me/vmshare", false).is_safe());
+        assert!(!m(4, "smbfs", "/Volumes/share", false).is_safe());
+        assert!(!m(5, "macfuse", "/Volumes/sshfs", true).is_safe());
+        assert!(!m(6, "autofs", "/System/Volumes/Data/home", true).is_safe());
+        assert!(!m(7, "apfs", "/Volumes/remote", false).is_safe());
+    }
+
+    #[test]
+    fn boundary_decisions() {
+        let mounts = vec![
+            m(10, "apfs", "/", true),
+            m(11, "apfs", "/System/Volumes/Data", true),
+            m(12, "nfs", "/Users/me/vmshare", false),
+            m(13, "smbfs", "/Users/me/mnt/nas", false),
+            m(14, "macfuse", "/Users/me/mnt/sshfs", true),
+            m(15, "devfs", "/dev", true),
+        ];
+        let dirs: HashMap<&[u8], (u64, u64)> = [
+            (&b"/Users/me"[..], (11, 100)),
+            (&b"/Users/me/mnt"[..], (11, 200)),
+        ]
+        .into();
+        let t = MountTable::build(&mounts, |p| dirs.get(p).copied());
+        assert_eq!(t.dev_safe(10), Some(true));
+        assert_eq!(t.dev_safe(11), Some(true));
+        assert_eq!(t.dev_safe(12), Some(false));
+        assert_eq!(t.dev_safe(14), Some(false));
+        assert_eq!(t.dev_safe(15), Some(false));
+        assert_eq!(t.dev_safe(99), None);
+
+        assert!(t.is_boundary_parent(11, 100));
+        assert!(t.is_boundary_parent(11, 200));
+        assert!(!t.is_boundary_parent(11, 300));
+        assert!(t.is_unsafe_mountpoint(11, 100, b"vmshare"));
+        assert!(!t.is_unsafe_mountpoint(11, 100, b"dev"));
+        assert!(t.is_unsafe_mountpoint(11, 200, b"nas"));
+        assert!(t.is_unsafe_mountpoint(11, 200, b"sshfs"));
+        // devfs at /dev: the parent "/" was not resolvable in this fake.
+        assert!(!t.is_boundary_parent(10, 2));
+    }
+
+    #[test]
+    fn same_device_mounted_twice_is_unsafe_if_any_is() {
+        let t = MountTable::build(
+            &[m(20, "apfs", "/a", true), m(20, "nullfs", "/b", true)],
+            |_| None,
+        );
+        assert_eq!(t.dev_safe(20), Some(false));
+    }
+
+    #[test]
+    fn host_mount_table_matches_stat() {
+        let mounts = enumerate().unwrap();
+        let data = mounts
+            .iter()
+            .find(|m| m.path == b"/System/Volumes/Data")
+            .expect("data volume");
+        assert!(data.is_safe(), "{data:?}");
+        // st_dev of a file equals the fsid of its volume.
+        let tmp = std::env::temp_dir();
+        let (tdev, _) = lstat_dir(tmp.as_os_str().as_bytes()).unwrap();
+        assert_eq!(tdev, data.dev);
+        let b = MountBoundaries::shared();
+        assert!(b.is_safe_dev(tdev));
+        assert!(!b.is_safe_dev(0xdead_beef));
+    }
+}
diff --git a/src/devices/src/virtio/fs/macos/fileops.rs b/src/devices/src/virtio/fs/macos/fileops.rs
new file mode 100644
index 00000000..f828e2b9
--- /dev/null
+++ b/src/devices/src/virtio/fs/macos/fileops.rs
@@ -0,0 +1,473 @@
+//! File data operations with macOS-specific implementations: barrier fsync
+//! and copy_file_range backed by APFS clones.
+
+use std::ffi::{CStr, CString};
+use std::fs::File;
+use std::io;
+use std::mem::MaybeUninit;
+use std::os::fd::{AsRawFd, FromRawFd, RawFd};
+use std::os::unix::ffi::OsStrExt;
+use std::path::Path;
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const CLONE_NOOWNERCOPY: u32 = 0x0002;
+/// One COPY_FILE_RANGE request copies at most this much; the guest loops.
+const MAX_COPY: u64 = 128 << 20;
+const COPY_CHUNK: usize = 1 << 20;
+
+/// FSYNC: `F_BARRIERFSYNC` orders the writes on the device without the full
+/// cache flush of `F_FULLFSYNC`, which is far slower on Apple SSDs. Falls back
+/// to `fsync` where the volume does not support barriers. With `no_sync` the
+/// call is a no-op (the share's data is disposable).
+pub fn fsync(fd: RawFd, no_sync: bool) -> io::Result<()> {
+    if no_sync {
+        return Ok(());
+    }
+    if unsafe { libc::fcntl(fd, libc::F_BARRIERFSYNC) } == 0 {
+        return Ok(());
+    }
+    if unsafe { libc::fsync(fd) } == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+fn fstat(fd: RawFd) -> io::Result<libc::stat> {
+    let mut st = MaybeUninit::<libc::stat>::zeroed();
+    if unsafe { libc::fstat(fd, st.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { st.assume_init() })
+}
+
+fn fd_path(fd: RawFd) -> io::Result<CString> {
+    let mut buf = vec![0u8; libc::PATH_MAX as usize];
+    if unsafe { libc::fcntl(fd, libc::F_GETPATH, buf.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let len = buf.iter().position(|&b| b == 0).unwrap_or(buf.len());
+    buf.truncate(len);
+    CString::new(buf).map_err(|_| io::Error::from_raw_os_error(libc::EINVAL))
+}
+
+fn xattr_names(fd: RawFd) -> io::Result<Vec<CString>> {
+    let opts = 0;
+    let size = unsafe { libc::flistxattr(fd, std::ptr::null_mut(), 0, opts) };
+    if size < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let mut buf = vec![0u8; size as usize];
+    let size = unsafe { libc::flistxattr(fd, buf.as_mut_ptr().cast(), buf.len(), opts) };
+    if size < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    buf.truncate(size as usize);
+    Ok(buf
+        .split(|&b| b == 0)
+        .filter(|n| !n.is_empty())
+        .map(|n| CString::new(n).unwrap())
+        .collect())
+}
+
+/// Give `to` exactly the extended attributes of `from`.
+fn replace_xattrs(from: RawFd, to: RawFd) -> io::Result<()> {
+    for name in xattr_names(to)? {
+        unsafe { libc::fremovexattr(to, name.as_ptr(), 0) };
+    }
+    for name in xattr_names(from)? {
+        let n = unsafe { libc::fgetxattr(from, name.as_ptr(), std::ptr::null_mut(), 0, 0, 0) };
+        if n < 0 {
+            continue;
+        }
+        let mut val = vec![0u8; n as usize];
+        let n = unsafe {
+            libc::fgetxattr(
+                from,
+                name.as_ptr(),
+                val.as_mut_ptr().cast(),
+                val.len(),
+                0,
+                0,
+            )
+        };
+        if n < 0 {
+            continue;
+        }
+        let res =
+            unsafe { libc::fsetxattr(to, name.as_ptr(), val.as_ptr().cast(), n as usize, 0, 0) };
+        // macOS manages some com.apple.* attributes itself (provenance).
+        if res != 0 && !name.to_bytes().starts_with(b"com.apple.") {
+            return Err(io::Error::last_os_error());
+        }
+    }
+    Ok(())
+}
+
+/// Replace the empty file open as `dst` with an APFS clone of `src`, keeping
+/// the path, mode and extended attributes of `dst`. The new file has a
+/// different inode, so the caller must point its node and handles at the
+/// returned file (opened with `dst`'s access mode).
+///
+/// Returns `None` when a clone does not apply (not a whole-file copy into an
+/// empty file on the same volume); the caller then copies the bytes.
+pub fn clone_whole_file(
+    src: RawFd,
+    off_in: u64,
+    dst: RawFd,
+    off_out: u64,
+    len: u64,
+) -> io::Result<Option<(File, u64)>> {
+    let (s, d) = (fstat(src)?, fstat(dst)?);
+    let regular = |st: &libc::stat| st.st_mode & libc::S_IFMT == libc::S_IFREG;
+    if off_in != 0
+        || off_out != 0
+        || !regular(&s)
+        || !regular(&d)
+        || s.st_size <= 0
+        || (len as i64) < s.st_size
+        || d.st_size != 0
+        || d.st_nlink != 1
+        || s.st_dev != d.st_dev
+    {
+        debug!("clone: not a whole-file copy into an empty file");
+        return Ok(None);
+    }
+
+    let dst_path = fd_path(dst)?;
+    let path = Path::new(std::ffi::OsStr::from_bytes(dst_path.as_bytes()));
+    let (Some(dir), Some(name)) = (path.parent(), path.file_name()) else {
+        return Ok(None);
+    };
+    static N: AtomicU64 = AtomicU64::new(0);
+    let mut tmp_name = b".kat-clone-".to_vec();
+    tmp_name.extend_from_slice(name.as_bytes());
+    tmp_name.extend_from_slice(
+        format!(
+            ".{}.{}",
+            std::process::id(),
+            N.fetch_add(1, Ordering::Relaxed)
+        )
+        .as_bytes(),
+    );
+    let tmp_path = CString::new(
+        dir.join(std::ffi::OsStr::from_bytes(&tmp_name))
+            .as_os_str()
+            .as_bytes(),
+    )
+    .map_err(|_| io::Error::from_raw_os_error(libc::EINVAL))?;
+
+    if unsafe { libc::fclonefileat(src, libc::AT_FDCWD, tmp_path.as_ptr(), CLONE_NOOWNERCOPY) } != 0
+    {
+        let e = io::Error::last_os_error();
+        debug!("fclonefileat failed, copying instead: {e}");
+        return Ok(None);
+    }
+    let unlink_tmp = || unsafe { libc::unlink(tmp_path.as_ptr()) };
+
+    let accmode = unsafe { libc::fcntl(dst, libc::F_GETFL) } & (libc::O_ACCMODE | libc::O_APPEND);
+    let fd = unsafe {
+        libc::open(
+            tmp_path.as_ptr(),
+            accmode | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+        )
+    };
+    if fd < 0 {
+        let e = io::Error::last_os_error();
+        unlink_tmp();
+        return Err(e);
+    }
+    let file = unsafe { File::from_raw_fd(fd) };
+    let finish = || -> io::Result<()> {
+        replace_xattrs(dst, file.as_raw_fd())?;
+        if unsafe { libc::fchmod(file.as_raw_fd(), d.st_mode & 0o7777) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // A copy is a new write: give it a fresh mtime like a byte copy would.
+        if unsafe { libc::futimens(file.as_raw_fd(), std::ptr::null()) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        // Only replace the path if it still names the file the guest created.
+        let cur = lstat(&dst_path)?;
+        if cur.st_ino != d.st_ino || cur.st_dev != d.st_dev {
+            return Err(io::Error::from_raw_os_error(libc::ESTALE));
+        }
+        if unsafe { libc::rename(tmp_path.as_ptr(), dst_path.as_ptr()) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    };
+    if let Err(e) = finish() {
+        unlink_tmp();
+        debug!("clone of {:?} abandoned, copying instead: {e}", dst_path);
+        return Ok(None);
+    }
+    Ok(Some((file, s.st_size as u64)))
+}
+
+fn lstat(path: &CStr) -> io::Result<libc::stat> {
+    let mut st = MaybeUninit::<libc::stat>::zeroed();
+    if unsafe { libc::lstat(path.as_ptr(), st.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(unsafe { st.assume_init() })
+}
+
+/// Copy up to `len` bytes from `src` at `off_in` to `dst` at `off_out` with
+/// positioned reads and writes, stopping at the end of `src`.
+pub fn copy_bytes(src: RawFd, off_in: u64, dst: RawFd, off_out: u64, len: u64) -> io::Result<u64> {
+    let len = len.min(MAX_COPY);
+    let mut buf = vec![0u8; COPY_CHUNK.min(len as usize).max(1)];
+    let mut done = 0u64;
+    while done < len {
+        let want = ((len - done) as usize).min(buf.len());
+        let n = unsafe {
+            libc::pread(
+                src,
+                buf.as_mut_ptr().cast(),
+                want,
+                (off_in + done) as libc::off_t,
+            )
+        };
+        if n < 0 {
+            let e = io::Error::last_os_error();
+            if e.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return if done > 0 { Ok(done) } else { Err(e) };
+        }
+        if n == 0 {
+            break;
+        }
+        let mut written = 0usize;
+        while written < n as usize {
+            let w = unsafe {
+                libc::pwrite(
+                    dst,
+                    buf[written..].as_ptr().cast(),
+                    n as usize - written,
+                    (off_out + done + written as u64) as libc::off_t,
+                )
+            };
+            if w < 0 {
+                let e = io::Error::last_os_error();
+                if e.kind() == io::ErrorKind::Interrupted {
+                    continue;
+                }
+                return if done + written as u64 > 0 {
+                    Ok(done + written as u64)
+                } else {
+                    Err(e)
+                };
+            }
+            written += w as usize;
+        }
+        done += n as u64;
+    }
+    Ok(done)
+}
+
+/// How a COPY_FILE_RANGE was carried out.
+pub enum Copied {
+    /// `dst` was replaced by a clone of the whole of `src`, now open as this file.
+    Cloned(File, u64),
+    Bytes(u64),
+}
+
+pub fn copy_file_range(
+    src: RawFd,
+    off_in: u64,
+    dst: RawFd,
+    off_out: u64,
+    len: u64,
+) -> io::Result<Copied> {
+    if let Some((file, n)) = clone_whole_file(src, off_in, dst, off_out, len)? {
+        return Ok(Copied::Cloned(file, n));
+    }
+    copy_bytes(src, off_in, dst, off_out, len).map(Copied::Bytes)
+}
