+    #[test]
+    fn whole_file_copy_into_new_file_is_a_clone() {
+        let dir = TempDir::new();
+        let (sp, dp) = (dir.0.join("src"), dir.0.join("dst"));
+        let content = data(3 << 20);
+        std::fs::write(&sp, &content).unwrap();
+        let src = File::open(&sp).unwrap();
+        let dst = OpenOptions::new()
