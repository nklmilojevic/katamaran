@@ -38,6 +38,26 @@ thread_local! {
     static TIMED_OUT: Cell<bool> = const { Cell::new(false) };
     /// Opens this thread handed to a helper, for tests.
     static HELPER_OPENS: Cell<u64> = const { Cell::new(0) };
+    /// The descriptor and mtime (ns) of this thread's last inline open, which already stats it.
+    static LAST_MTIME: Cell<Option<(c_int, u64)>> = const { Cell::new(None) };
+}
+
+/// The mtime in nanoseconds of `fd` if this thread's last inline open returned it; clears it.
+pub fn take_mtime(fd: c_int) -> Option<u64> {
+    LAST_MTIME
+        .with(|m| m.take())
+        .and_then(|(f, mtime)| (f == fd).then_some(mtime))
+}
+
+/// Forgets the last inline open's mtime, before an open that may not go inline.
+pub fn clear_mtime() {
+    LAST_MTIME.with(|m| m.set(None));
+}
+
+pub fn mtime_ns(st: &libc::stat) -> u64 {
+    (st.st_mtime as u64)
+        .wrapping_mul(1_000_000_000)
+        .wrapping_add(st.st_mtime_nsec as u64)
 }
 
