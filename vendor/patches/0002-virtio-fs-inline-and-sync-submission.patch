+/// KATAMARAN_FS_STATS=1: every 2 s, log how many requests the server handled
+/// and the mean host time per request.
+pub fn start_stats_reporter() {
+    static STARTED: std::sync::Once = std::sync::Once::new();
+    if std::env::var("KATAMARAN_FS_STATS").as_deref() != Ok("1") {
+        return;
+    }
+    STARTED.call_once(|| {
+        thread::spawn(|| {
+            let (mut last_n, mut last_ns, mut last_inline, mut last_sync) = (0, 0, 0, 0);
+            loop {
+                thread::sleep(Duration::from_secs(2));
+                let (n, ns, inl, sync) = (
+                    STAT_REQS.load(Ordering::Relaxed),
+                    STAT_NS.load(Ordering::Relaxed),
+                    STAT_INLINE.load(Ordering::Relaxed),
+                    STAT_SYNC.load(Ordering::Relaxed),
+                );
+                let dn = n - last_n;
+                if dn > 0 {
+                    log::warn!(
+                        "fs stats: {} req/s, host {:.1} us/req, drains: {} notify-inline, {} sync",
+                        dn / 2,
+                        (ns - last_ns) as f64 / dn as f64 / 1000.0,
+                        inl - last_inline,
+                        sync - last_sync
+                    );
+                }
+                (last_n, last_ns, last_inline, last_sync) = (n, ns, inl, sync);
+            }
+        });
+    });
+}
