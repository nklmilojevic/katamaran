+/// Send one frame gathered from `iov`.
+pub(crate) fn send_iov(fd: RawFd, iov: &[libc::iovec]) -> Result<(), WriteError> {
+    // SAFETY: msghdr is plain data; all-zero is a valid empty header.
+    let mut msg: libc::msghdr = unsafe { std::mem::zeroed() };
+    msg.msg_iov = iov.as_ptr() as *mut libc::iovec;
+    msg.msg_iovlen = iov.len() as _;
+    // SAFETY: the caller guarantees each iovec points to readable memory
