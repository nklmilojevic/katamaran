+++ b/pkg/services/forwarder/listen_other.go
@@ -0,0 +1,17 @@
+//go:build !darwin
+
+package forwarder
+
+import "net"
+
+func listenLoopbackTCP(network, laddr string) (net.Listener, error) {
+	return net.Listen(network, laddr)
+}
+
+func listenLoopbackUDP(addr *net.UDPAddr) (udpConn, error) {
+	conn, err := net.ListenUDP("udp", addr)
+	if err != nil {
+		return nil, err
+	}
+	return conn, nil
+}
