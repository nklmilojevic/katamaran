 pkg/services/forwarder/listen_darwin_test.go | 170 ++++++++++++++++++
 pkg/services/forwarder/listen_other.go       |  17 ++
 pkg/services/forwarder/ports.go              |   3 +-
 4 files changed, 365 insertions(+), 1 deletion(-)
