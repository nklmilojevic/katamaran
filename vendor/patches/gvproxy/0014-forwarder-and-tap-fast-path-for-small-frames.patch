+// proxyEndpoint copies both ways between a gVisor TCP endpoint and a host
+// TCP connection using persistent waiter entries so small request/response
+// traffic avoids allocating a waiter channel and registering/unregistering on
+// every read.
+func proxyEndpoint(ep tcpip.Endpoint, wq *waiter.Queue, host *net.TCPConn) {
+	_ = host.SetKeepAlive(true)
+	_ = host.SetKeepAlivePeriod(hostKeepAlive)
+	_ = host.SetWriteBuffer(hostSocketBuffer)
+	_ = host.SetReadBuffer(hostSocketBuffer)
+	done := make(chan struct{}, 1)
+	go func() {
+		_, _ = copyToEndpoint(ep, wq, host)
+		_ = host.CloseRead()
+		_ = ep.Shutdown(tcpip.ShutdownWrite)
+		done <- struct{}{}
+	}()
+	_, _ = copyFromEndpoint(host, ep, wq)
+	_ = ep.Shutdown(tcpip.ShutdownRead)
+	_ = host.CloseWrite()
+	<-done
+	ep.Close()
+	_ = host.Close()
+}
+
+// copyFromEndpoint drains ep into dst with one persistent waiter entry and
+// batched receive-buffer moderation for small request/response traffic.
+func copyFromEndpoint(dst io.Writer, ep tcpip.Endpoint, wq *waiter.Queue) (int64, error) {
+	buf := make([]byte, copyBufferMin)
+	waitEntry, notifyCh := waiter.NewChannelEntry(waiter.ReadableEvents)
+	wq.EventRegister(&waitEntry)
+	defer wq.EventUnregister(&waitEntry)
+
+	var written int64
+	var moderated int
+	for {
+		w := tcpip.SliceWriter(buf)
+		res, terr := ep.Read(&w, tcpip.ReadOptions{})
+		if _, ok := terr.(*tcpip.ErrWouldBlock); ok {
+			<-notifyCh
+			continue
+		}
+		if res.Count > 0 {
+			n := res.Count
+			moderated += n
+			if n >= 4096 || moderated >= 32768 {
+				ep.ModerateRecvBuf(moderated)
+				moderated = 0
+			}
+			nw, werr := dst.Write(buf[:n])
+			written += int64(nw)
+			if werr != nil {
+				return written, werr
+			}
+			if nw != n {
+				return written, io.ErrShortWrite
+			}
+			if n == len(buf) && len(buf) < copyBufferSize {
+				buf = make([]byte, min(2*len(buf), copyBufferSize))
+			}
+		}
+		if terr != nil {
+			if _, ok := terr.(*tcpip.ErrClosedForReceive); ok {
+				return written, nil
+			}
+			return written, errors.New(terr.String())
+		}
+	}
+}
+
+// copyToEndpoint reads from src into ep directly, registering a writable
+// waiter only if the send buffer actually fills.
+func copyToEndpoint(ep tcpip.Endpoint, wq *waiter.Queue, src io.Reader) (int64, error) {
+	buf := make([]byte, copyBufferMin)
+	var (
+		r       bytes.Reader
+		written int64
+		entry   waiter.Entry
+		ch      <-chan struct{}
+	)
+	defer func() {
+		if ch != nil {
+			wq.EventUnregister(&entry)
+		}
+	}()
+	for {
+		n, rerr := src.Read(buf)
+		if n > 0 {
+			off := 0
+			for off < n {
+				r.Reset(buf[off:n])
+				nw, terr := ep.Write(&r, tcpip.WriteOptions{})
+				off += int(nw)
+				written += nw
+				switch terr.(type) {
+				case nil:
+				case *tcpip.ErrWouldBlock:
+					if ch == nil {
+						entry, ch = waiter.NewChannelEntry(waiter.WritableEvents)
+						wq.EventRegister(&entry)
+						continue
+					}
+					<-ch
+				default:
+					return written, errors.New(terr.String())
+				}
+			}
+			if n == len(buf) && len(buf) < copyBufferSize {
+				buf = make([]byte, min(2*len(buf), copyBufferSize))
+			}
+		}
+		if rerr == io.EOF {
+			return written, nil
+		}
+		if rerr != nil {
+			return written, rerr
+		}
+	}
+}
