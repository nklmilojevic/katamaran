+
+func (r *flatFrameRecorder) WritePacket(hdr []byte, frame [][]byte) error {
+	r.normal = append(r.normal, recordedFrame{bytes.Clone(hdr), bytes.Join(frame, nil)})
+	return nil
+}
+
+func (r *flatFrameRecorder) WriteFlat(frame []byte) error {
+	r.flat = append(r.flat, bytes.Clone(frame))
+	return nil
+}
+
+func TestCallbackFlatWriterForSmallFrames(t *testing.T) {
+	le, err := NewLinkEndpoint(false, 65520, stackMAC.String(), stackIP.String(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	le.Attach(&fakeDispatcher{})
+	sw := NewSwitch(false)
+	le.Connect(sw)
+	sw.Connect(le)
+	var rec flatFrameRecorder
+	link := sw.ConnectCallback(&rec)
+
+	in := frame(1)
+	copy(in[0:6], stackMAC)
+	copy(in[6:12], guestMAC)
+	link.Inject(in, buffer.MakeWithData(in))
+
+	small := outboundTCP(t, []byte("ok"))
+	sw.DeliverNetworkPacket(header.IPv4ProtocolNumber, small)
+	wantSmall := small.ToView().AsSlice()
+	small.DecRef()
+	if len(rec.flat) != 1 || len(rec.normal) != 0 {
+		t.Fatalf("small frame: flat=%d normal=%d", len(rec.flat), len(rec.normal))
+	}
+	if !bytes.Equal(rec.flat[0][virtioNetHdrLen:], wantSmall) || rec.flat[0][0] != virtioNetHdrFNeedsCsum {
+		t.Fatalf("flat frame mismatch: hdr=%x len=%d", rec.flat[0][:virtioNetHdrLen], len(rec.flat[0]))
+	}
+
+	large := outboundTCP(t, bytes.Repeat([]byte{5}, flatPacketMax+100))
+	sw.DeliverNetworkPacket(header.IPv4ProtocolNumber, large)
+	wantLarge := large.ToView().AsSlice()
+	large.DecRef()
+	if len(rec.flat) != 1 || len(rec.normal) != 1 {
+		t.Fatalf("large frame: flat=%d normal=%d", len(rec.flat), len(rec.normal))
+	}
+	if !bytes.Equal(rec.normal[0].frame, wantLarge) {
+		t.Fatal("large frame content mismatch")
+	}
+}
