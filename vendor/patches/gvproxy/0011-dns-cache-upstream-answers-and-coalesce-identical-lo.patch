+func TestServerSendsCachedTTLs(t *testing.T) {
+	up := newFakeUpstream(func(q dns.Question) (*lookupResult, error) {
+		return positive(
+			mustRR(t, "www.example.org. 3600 IN CNAME example.org."),
+			mustRR(t, "example.org. 120 IN A 192.0.2.1"),
+		), nil
+	})
+	udpConn, err := net.ListenPacket("udp", "127.0.0.1:0")
+	require.NoError(t, err)
+	tcpLn, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	defer udpConn.Close()
+	defer tcpLn.Close()
+	server, err := NewWithUpstreamResolver(udpConn, tcpLn, nil, &mockdns.Resolver{})
+	require.NoError(t, err)
+	server.handler.resolver = newCachingResolver(up.lookup, testCacheConfig, nil)
+	go func() { _ = server.Serve() }()
+	go func() { _ = server.ServeTCP() }()
+
+	for _, network := range []string{"udp", "tcp"} {
+		addr := udpConn.LocalAddr().String()
+		if network == "tcp" {
+			addr = tcpLn.Addr().String()
+		}
+		m := new(dns.Msg)
+		m.SetQuestion("www.example.org.", dns.TypeA)
+		client := &dns.Client{Net: network, Timeout: 5 * time.Second}
+		resp, _, err := client.Exchange(m, addr)
+		require.NoError(t, err, network)
+		require.Equal(t, dns.RcodeSuccess, resp.Rcode)
+		require.True(t, resp.RecursionAvailable)
+		require.Len(t, resp.Answer, 2)
+		require.Equal(t, uint32(120), resp.Answer[0].Header().Ttl, "%s: capped at how long the answer is cached", network)
+		require.Equal(t, uint32(120), resp.Answer[1].Header().Ttl, network)
+	}
+	require.Equal(t, 1, up.count("www.example.org.", dns.TypeA))
+}
