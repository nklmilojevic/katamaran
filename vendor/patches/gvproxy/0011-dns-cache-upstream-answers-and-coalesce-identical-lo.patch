+// addResolvedAnswers answers q from h.resolver. It returns false, leaving m
+// alone, when the resolver is unavailable.
+func (h *dnsHandler) addResolvedAnswers(m *dns.Msg, q dns.Question) bool {
+	res, err := h.resolver.resolve(context.Background(), q)
+	if errors.Is(err, errResolverUnavailable) {
+		return false
+	}
+	if err != nil {
+		log.Debugf("dns: resolving %s %s: %v", q.Name, dns.TypeToString[q.Qtype], err)
+		m.Rcode = dns.RcodeServerFailure
+		return true
+	}
+	// Answer under the name exactly as asked, in case the client checks
+	// its case (DNS 0x20).
+	for _, rr := range res.Answer {
+		if hdr := rr.Header(); strings.EqualFold(hdr.Name, q.Name) {
+			hdr.Name = q.Name
+		}
+	}
+	m.Answer = append(m.Answer, res.Answer...)
+	m.Ns = append(m.Ns, res.Ns...)
+	m.Rcode = res.Rcode
+	return true
+}
