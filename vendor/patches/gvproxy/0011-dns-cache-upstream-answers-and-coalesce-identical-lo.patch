+func TestCacheCoalescesConcurrentLookups(t *testing.T) {
+	up := newFakeUpstream(func(q dns.Question) (*lookupResult, error) {
+		// Not cacheable, so only coalescing keeps this to one call.
+		return &lookupResult{Rcode: dns.RcodeServerFailure, Answer: []dns.RR{mustRR(t, q.Name+" 300 IN A 192.0.2.1")}}, nil
+	})
+	up.gate = make(chan struct{})
+	c, _ := newTestCache(up, nil)
+	q := question("example.org.", dns.TypeA)
+
+	const n = 20
+	results := make([]*lookupResult, n)
+	var wg sync.WaitGroup
+	for i := range n {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			res, err := c.lookup(context.Background(), q)
+			if err == nil {
+				results[i] = res
+			}
+		}()
+	}
+	// One asker gives up early; the others still get the answer.
+	ctx, cancel := context.WithCancel(context.Background())
+	gaveUp := make(chan error, 1)
+	go func() {
+		_, err := c.lookup(ctx, q)
+		gaveUp <- err
+	}()
+	waitForWaiters(t, c, q, n+1)
+	cancel()
+	require.ErrorIs(t, <-gaveUp, context.Canceled)
+	close(up.gate)
+	wg.Wait()
+
+	require.Equal(t, 1, up.count("example.org.", dns.TypeA))
+	for i, res := range results {
+		require.NotNil(t, res, "asker %d", i)
+		require.Len(t, res.Answer, 1)
+	}
+	results[0].Answer[0].Header().Name = "changed."
+	require.Equal(t, "example.org.", results[1].Answer[0].Header().Name, "each asker gets its own copy")
+}
