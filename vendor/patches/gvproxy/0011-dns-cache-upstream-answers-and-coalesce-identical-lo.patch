+func TestResolverTellsNXDOMAINFromNODATA(t *testing.T) {
+	negative := &lookupResult{Rcode: dns.RcodeNameError, NegativeTTL: 60, ambiguous: true}
+	up := newFakeUpstream(func(q dns.Question) (*lookupResult, error) {
+		switch {
+		case q.Name == "v4only.example." && q.Qtype == dns.TypeA:
+			return positive(mustRR(t, "v4only.example. 300 IN A 192.0.2.1")), nil
+		case q.Name == "v6only.example." && q.Qtype == dns.TypeAAAA:
+			return positive(mustRR(t, "v6only.example. 300 IN AAAA 2001:db8::1")), nil
+		case q.Name == "alias.example.":
+			res := *negative
+			res.Answer = []dns.RR{mustRR(t, "alias.example. 300 IN CNAME v4only.example.")}
+			return &res, nil
+		case q.Name == "broken-alias.example.":
+			res := *negative
+			res.Answer = []dns.RR{mustRR(t, "broken-alias.example. 300 IN CNAME nothing.example.")}
+			return &res, nil
+		case q.Name == "flaky.example." && q.Qtype == dns.TypeA:
+			return nil, errors.New("timed out")
+		default:
+			return negative, nil
+		}
+	})
+	r := newCachingResolver(up.lookup, testCacheConfig, nil)
+	resolve := func(name string, qtype uint16) *lookupResult {
+		t.Helper()
+		res, err := r.resolve(context.Background(), question(name, qtype))
+		require.NoError(t, err)
+		return res
+	}
+
+	res := resolve("v4only.example.", dns.TypeAAAA)
+	require.Equal(t, dns.RcodeSuccess, res.Rcode, "an IPv4-only name has no AAAA, but exists")
+	require.Empty(t, res.Answer)
+	require.Equal(t, dns.RcodeSuccess, resolve("v4only.example.", dns.TypeA).Rcode)
+	require.Equal(t, 1, up.count("v4only.example.", dns.TypeA), "the client's own A query reuses the probe's answer")
+
+	require.Equal(t, dns.RcodeSuccess, resolve("v6only.example.", dns.TypeA).Rcode)
+	require.Equal(t, dns.RcodeSuccess, resolve("v4only.example.", dns.TypeMX).Rcode)
+	require.Equal(t, dns.RcodeNameError, resolve("nothing.example.", dns.TypeA).Rcode)
+	require.Equal(t, dns.RcodeNameError, resolve("nothing.example.", dns.TypeAAAA).Rcode)
+	require.Equal(t, dns.RcodeNameError, resolve("nothing.example.", dns.TypeTXT).Rcode)
+
+	res = resolve("alias.example.", dns.TypeAAAA)
+	require.Equal(t, dns.RcodeSuccess, res.Rcode, "the name a CNAME leads to is the one probed")
+	require.Len(t, res.Answer, 1)
+	res = resolve("broken-alias.example.", dns.TypeA)
+	require.Equal(t, dns.RcodeNameError, res.Rcode, "RFC 6604: the rcode is the last name's")
+	require.Len(t, res.Answer, 1)
+
+	require.Equal(t, dns.RcodeSuccess, resolve("flaky.example.", dns.TypeAAAA).Rcode, "a failed probe answers NODATA")
+}
