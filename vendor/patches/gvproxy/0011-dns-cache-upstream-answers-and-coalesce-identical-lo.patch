+// waitForWaiters blocks until n askers wait on the lookup of q.
+func waitForWaiters(t *testing.T, c *answerCache, q dns.Question, n int) {
+	t.Helper()
+	key := cacheKey{strings.ToLower(q.Name), q.Qtype, q.Qclass}
+	require.Eventually(t, func() bool {
+		c.mu.Lock()
+		defer c.mu.Unlock()
+		f := c.flights[key]
+		return f != nil && f.waiters == n
+	}, 5*time.Second, time.Millisecond)
+}
