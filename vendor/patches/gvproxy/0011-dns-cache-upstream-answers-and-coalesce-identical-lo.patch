+func TestHandlerAnswersFromTheResolver(t *testing.T) {
+	up := newFakeUpstream(func(q dns.Question) (*lookupResult, error) {
+		switch strings.ToLower(q.Name) {
+		case "example.org.":
+			if q.Qtype == dns.TypeA {
+				return positive(mustRR(t, "example.org. 300 IN A 192.0.2.1")), nil
+			}
+			return &lookupResult{Rcode: dns.RcodeNameError, NegativeTTL: 60, ambiguous: true}, nil
+		case "unreachable.example.":
+			return nil, errors.New("timed out")
+		default:
+			return nil, errResolverUnavailable
+		}
+	})
+	h := &dnsHandler{
+		zones: []types.Zone{{
+			Name:    "containers.internal.",
+			Records: []types.Record{{Name: "host", IP: net.ParseIP("192.168.127.254")}},
+		}},
+		upstream: &mockdns.Resolver{Zones: map[string]mockdns.Zone{
+			"fallback.example.": {A: []string{"192.0.2.9"}},
+		}},
+		client:   &dns.Client{},
+		resolver: newCachingResolver(up.lookup, testCacheConfig, nil),
+	}
+	query := func(name string, qtype uint16) *dns.Msg {
+		m := new(dns.Msg)
+		m.SetQuestion(name, qtype)
+		h.addAnswers(m)
+		return m
+	}
+
+	m := query("host.containers.internal.", dns.TypeA)
+	require.Equal(t, dns.RcodeSuccess, m.Rcode)
+	require.Len(t, m.Answer, 1)
+	require.Equal(t, "192.168.127.254", m.Answer[0].(*dns.A).A.String())
+	require.Equal(t, uint32(0), m.Answer[0].Header().Ttl, "local zones answer as before")
+	m = query("host.containers.internal.", dns.TypeAAAA)
+	require.Equal(t, dns.RcodeSuccess, m.Rcode)
+	require.Empty(t, m.Answer)
+	require.Equal(t, dns.RcodeNameError, query("nothing.containers.internal.", dns.TypeA).Rcode)
+	require.Zero(t, up.count("host.containers.internal.", dns.TypeA)+up.count("host.containers.internal.", dns.TypeAAAA))
+
+	m = query("ExAmple.org.", dns.TypeA)
+	require.Equal(t, dns.RcodeSuccess, m.Rcode)
+	require.Len(t, m.Answer, 1)
+	require.Equal(t, "ExAmple.org.", m.Answer[0].Header().Name, "answers carry the name as asked")
+	require.Equal(t, uint32(300), m.Answer[0].Header().Ttl)
+	m = query("example.org.", dns.TypeAAAA)
+	require.Equal(t, dns.RcodeSuccess, m.Rcode)
+	require.Empty(t, m.Answer)
+
+	require.Equal(t, dns.RcodeServerFailure, query("unreachable.example.", dns.TypeA).Rcode)
+
+	m = query("fallback.example.", dns.TypeA)
+	require.Equal(t, dns.RcodeSuccess, m.Rcode, "without the system resolver, questions go the old way")
+	require.Len(t, m.Answer, 1)
+	require.Equal(t, "192.0.2.9", m.Answer[0].(*dns.A).A.String())
+}
