+func TestCacheEmptiesWhenTheConfigurationChanges(t *testing.T) {
+	up := newFakeUpstream(func(q dns.Question) (*lookupResult, error) {
+		return positive(mustRR(t, q.Name+" 300 IN A 192.0.2.1")), nil
+	})
+	var mu sync.Mutex
+	changed := false
+	c, _ := newTestCache(up, func() bool {
+		mu.Lock()
+		defer mu.Unlock()
+		was := changed
+		changed = false
+		return was
+	})
+	q := question("example.org.", dns.TypeA)
+	lookupOK(t, c, q)
+	lookupOK(t, c, q)
+	require.Equal(t, 1, up.count("example.org.", dns.TypeA))
+
+	mu.Lock()
+	changed = true
+	mu.Unlock()
+	lookupOK(t, c, q)
+	require.Equal(t, 2, up.count("example.org.", dns.TypeA))
+
+	// A lookup that started before a change is not stored after it.
+	up.gate = make(chan struct{})
+	stale := question("stale.example.", dns.TypeA)
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		_, _ = c.lookup(context.Background(), stale)
+	}()
+	waitForWaiters(t, c, stale, 1)
+	c.flush()
+	close(up.gate)
+	<-done
+	require.Zero(t, c.len())
+}
