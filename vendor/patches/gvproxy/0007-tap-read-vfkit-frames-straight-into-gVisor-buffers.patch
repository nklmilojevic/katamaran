diff --git a/pkg/tap/rxframe.go b/pkg/tap/rxframe.go
new file mode 100644
index 0000000..1c3acbf
--- /dev/null
+++ b/pkg/tap/rxframe.go
@@ -0,0 +1,113 @@
+package tap
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"sync/atomic"
+	"syscall"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/google/gopacket"
+	"github.com/google/gopacket/layers"
+	log "github.com/sirupsen/logrus"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+// rxViewSize is the receive buffer for one datagram: the largest pooled
+// gVisor chunk, above the largest frame (an MTU of 65520 plus the Ethernet
+// header). Larger datagrams arrive truncated and are dropped.
+const rxViewSize = buffer.MaxChunkSize
+
+// rxCopyBelow is the frame size under which a frame is copied out of the
+// receive view, so the view is read into again. gVisor zeroes a chunk when it
+// hands one out, so taking a fresh 64 KiB view for every ACK would cost more
+// than copying it.
+const rxCopyBelow = 4096
+
+// datagramReader is a datagram socket that reports truncation, as
+// *net.UnixConn does.
+type datagramReader interface {
+	ReadMsgUnix(b, oob []byte) (n, oobn, flags int, addr *net.UnixAddr, err error)
+}
+
+// rxDatagrams reads frames from a datagram socket straight into gVisor
+// buffers: a large frame is passed on in the view it was read into, instead of
+// being read into a scratch slice and copied into a new buffer, which on a
+// fast upload kept the reading goroutine busy copying.
+func (e *Switch) rxDatagrams(ctx context.Context, id int, conn datagramReader) error {
+	view := buffer.NewViewSize(rxViewSize)
+	defer func() { view.Release() }()
+	for ctx.Err() == nil {
+		buf := view.AsSlice()
+		n, _, flags, _, err := conn.ReadMsgUnix(buf, nil)
+		if err != nil {
+			return fmt.Errorf("cannot read size from socket: %w", err)
+		}
+		if flags&syscall.MSG_TRUNC != 0 {
+			log.Warnf("dropping a frame larger than %d bytes", len(buf))
+			continue
+		}
+		frame := buf[:n]
+		if n < rxCopyBelow {
+			e.rxFrame(id, frame, buffer.MakeWithData(frame))
+			continue
+		}
+		view.CapLength(n)
+		e.rxFrame(id, frame, buffer.MakeWithView(view))
+		view = buffer.NewViewSize(rxViewSize)
+	}
+	return nil
+}
+
+// rxFrame switches one frame from a VM. data holds the frame's bytes, which
+// frame also points to, and rxFrame takes it over.
+func (e *Switch) rxFrame(id int, frame []byte, data buffer.Buffer) {
+	if len(frame) < header.EthernetMinimumSize {
+		data.Release()
+		return
+	}
+	if e.debug {
+		packet := gopacket.NewPacket(frame, layers.LayerTypeEthernet, gopacket.Default)
+		log.Info(packet.String())
+	}
+	size := len(frame)
+	eth := header.Ethernet(frame)
+	src, dst, typ := eth.SourceAddress(), eth.DestinationAddress(), eth.Type()
+
+	e.camLock.Lock()
+	_, exists := e.cam[src]
+	e.cam[src] = id
+	e.camLock.Unlock()
+
+	if !exists && e.notificationSender != nil {
+		e.notificationSender.Send(types.NotificationMessage{
+			NotificationType: types.ConnectionEstablished,
+			MacAddress:       src.String(),
+		})
+	}
+
+	gateway := e.gateway.LinkAddress()
+	toGateway := dst == gateway || dst == header.EthernetBroadcastAddress
+	if dst != gateway {
+		payload := data
+		if toGateway {
+			payload = data.Clone()
+		}
+		pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: payload})
+		if err := e.tx(pkt); err != nil {
+			log.Error(err)
+		}
+		pkt.DecRef()
+	}
+	if toGateway {
+		data.TrimFront(header.EthernetMinimumSize)
+		pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: data})
+		e.gateway.DeliverNetworkPacket(typ, pkt)
+		pkt.DecRef()
+	}
+
+	atomic.AddUint64(&e.Received, uint64(size))
+}
