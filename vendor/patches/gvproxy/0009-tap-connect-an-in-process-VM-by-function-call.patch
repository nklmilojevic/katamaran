diff --git a/pkg/tap/callback.go b/pkg/tap/callback.go
new file mode 100644
index 0000000..601ccee
--- /dev/null
+++ b/pkg/tap/callback.go
@@ -0,0 +1,82 @@
+package tap
+
+import (
+	"errors"
+	"net"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+// PacketWriter receives the frames for a VM that runs in this process, such
+// as one whose VMM loads gvproxy as a library: no socket and no goroutine sit
+// between the stack and the VM's receive queue.
+type PacketWriter interface {
+	// WritePacket writes one frame: hdr, a virtio-net header, followed by
+	// the frame in slices. It must not block and may only read the slices
+	// during the call.
+	WritePacket(hdr []byte, frame [][]byte) error
+}
+
+// CallbackLink connects an in-process VM to the switch.
+type CallbackLink struct {
+	sw *Switch
+	id int
+}
+
+// ConnectCallback adds a VM whose frames go to w. Frames to it are written
+// on the goroutine that produced them, and the stack leaves TCP and UDP
+// checksums to the VM (virtio-net's NEEDS_CSUM), since nothing between them
+// can corrupt a frame.
+func (e *Switch) ConnectCallback(w PacketWriter) *CallbackLink {
+	id, _ := e.connect(protocolConn{
+		Conn:         &callbackConn{w: w},
+		protocolImpl: protocolImplementation(types.VfkitProtocol),
+	})
+	if le, ok := e.gateway.(*LinkEndpoint); ok {
+		le.txChecksumOffload.Store(true)
+	}
+	e.txInline.Store(true)
+	return &CallbackLink{sw: e, id: id}
+}
+
+// Inject hands a frame from the VM to the switch. frame holds its bytes and
+// data a buffer with the same bytes, which Inject takes over.
+func (l *CallbackLink) Inject(frame []byte, data buffer.Buffer) {
+	l.sw.rxFrame(l.id, frame, data)
+}
+
+// callbackConn stands in for a VM's socket in the switch's connection table.
+type callbackConn struct {
+	w PacketWriter
+}
+
+var errCallbackConn = errors.New("in-process VM link has no socket")
+
+func (c *callbackConn) writePacket(pkt *stack.PacketBuffer) error {
+	hdr := guestNetHeader(pkt)
+	return c.w.WritePacket(hdr[:], pkt.AsSlices())
+}
+
+func (c *callbackConn) Write(b []byte) (int, error) {
+	var hdr [virtioNetHdrLen]byte
+	if err := c.w.WritePacket(hdr[:], [][]byte{b}); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+
+func (c *callbackConn) Read([]byte) (int, error)         { return 0, errCallbackConn }
+func (c *callbackConn) Close() error                     { return nil }
+func (c *callbackConn) LocalAddr() net.Addr              { return callbackAddr{} }
+func (c *callbackConn) RemoteAddr() net.Addr             { return callbackAddr{} }
+func (c *callbackConn) SetDeadline(time.Time) error      { return nil }
+func (c *callbackConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *callbackConn) SetWriteDeadline(time.Time) error { return nil }
+
+type callbackAddr struct{}
+
+func (callbackAddr) Network() string { return "callback" }
+func (callbackAddr) String() string  { return "in-process VM" }
diff --git a/pkg/tap/callback_test.go b/pkg/tap/callback_test.go
new file mode 100644
index 0000000..e8901ec
--- /dev/null
+++ b/pkg/tap/callback_test.go
@@ -0,0 +1,138 @@
+package tap
+
+import (
+	"bytes"
+	"encoding/binary"
+	"testing"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/checksum"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+var (
+	stackMAC = tcpip.LinkAddress("\x5a\x94\xef\xe4\x0c\x01")
+	stackIP  = tcpip.AddrFrom4([4]byte{192, 168, 127, 1})
+	guestIP  = tcpip.AddrFrom4([4]byte{192, 168, 127, 2})
+)
+
+// outboundTCP builds a frame as the stack sends it to the guest with
+// checksum offload: Ethernet, IPv4 and TCP headers pushed, no TCP checksum.
+func outboundTCP(t *testing.T, payload []byte) *stack.PacketBuffer {
+	t.Helper()
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{
+		ReserveHeaderBytes: header.EthernetMinimumSize + header.IPv4MinimumSize + header.TCPMinimumSize,
+		Payload:            buffer.MakeWithData(payload),
+	})
+	tcp := header.TCP(pkt.TransportHeader().Push(header.TCPMinimumSize))
+	tcp.Encode(&header.TCPFields{SrcPort: 80, DstPort: 40000, SeqNum: 1, AckNum: 2,
+		DataOffset: header.TCPMinimumSize, Flags: header.TCPFlagAck, WindowSize: 1000})
+	pkt.TransportProtocolNumber = header.TCPProtocolNumber
+	ip := header.IPv4(pkt.NetworkHeader().Push(header.IPv4MinimumSize))
+	ip.Encode(&header.IPv4Fields{TotalLength: uint16(header.IPv4MinimumSize + header.TCPMinimumSize + len(payload)),
+		TTL: 64, Protocol: uint8(header.TCPProtocolNumber), SrcAddr: stackIP, DstAddr: guestIP})
+	ip.SetChecksum(^ip.CalculateChecksum())
+	pkt.NetworkProtocolNumber = header.IPv4ProtocolNumber
+	eth := header.Ethernet(pkt.LinkHeader().Push(header.EthernetMinimumSize))
+	eth.Encode(&header.EthernetFields{SrcAddr: stackMAC, DstAddr: guestMAC, Type: header.IPv4ProtocolNumber})
+	return pkt
+}
+
+func TestGuestNetHeaderLeavesAPartialChecksumTheGuestCompletes(t *testing.T) {
+	payload := bytes.Repeat([]byte("katamaran"), 1000)
+	pkt := outboundTCP(t, payload)
+	defer pkt.DecRef()
+
+	hdr := guestNetHeader(pkt)
+	if hdr[0] != virtioNetHdrFNeedsCsum {
+		t.Fatalf("flags %#x, want NEEDS_CSUM", hdr[0])
+	}
+	start := int(binary.LittleEndian.Uint16(hdr[6:]))
+	offset := int(binary.LittleEndian.Uint16(hdr[8:]))
+	if start != header.EthernetMinimumSize+header.IPv4MinimumSize || offset != header.TCPChecksumOffset {
+		t.Fatalf("csum_start %d csum_offset %d", start, offset)
+	}
+
+	// Complete it as the guest would: sum from csum_start to the end, with
+	// the field holding the pseudo-header sum, and store the complement.
+	frame := pkt.ToView().AsSlice()
+	sum := checksum.Checksum(frame[start:], 0)
+	binary.BigEndian.PutUint16(frame[start+offset:], ^sum)
+
+	tcp := header.TCP(frame[start:])
+	if !tcp.IsChecksumValid(stackIP, guestIP, checksum.Checksum(payload, 0), uint16(len(payload))) {
+		t.Fatal("the completed checksum is wrong")
+	}
+}
+
+func TestGuestNetHeaderLeavesOtherFramesAlone(t *testing.T) {
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(frame(1))})
+	defer pkt.DecRef()
+	if hdr := guestNetHeader(pkt); hdr != [virtioNetHdrLen]byte{} {
+		t.Fatalf("header % x for a frame without a transport header", hdr)
+	}
+}
+
+type recordedFrame struct {
+	hdr   []byte
+	frame []byte
+}
+
+type frameRecorder struct{ frames []recordedFrame }
+
+func (r *frameRecorder) WritePacket(hdr []byte, frame [][]byte) error {
+	r.frames = append(r.frames, recordedFrame{bytes.Clone(hdr), bytes.Join(frame, nil)})
+	return nil
+}
+
+// fakeDispatcher records what the link endpoint delivers to the stack.
+type fakeDispatcher struct{ delivered [][]byte }
+
+func (d *fakeDispatcher) DeliverNetworkPacket(_ tcpip.NetworkProtocolNumber, pkt *stack.PacketBuffer) {
+	d.delivered = append(d.delivered, bytes.Clone(pkt.ToView().AsSlice()))
+}
+
+func (d *fakeDispatcher) DeliverLinkPacket(tcpip.NetworkProtocolNumber, *stack.PacketBuffer) {}
+
+func TestCallbackLinkCarriesFramesBothWays(t *testing.T) {
+	le, err := NewLinkEndpoint(false, 1500, stackMAC.String(), stackIP.String(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	gw := &fakeDispatcher{}
+	le.Attach(gw)
+	sw := NewSwitch(false)
+	le.Connect(sw)
+	sw.Connect(le)
+	var rec frameRecorder
+	link := sw.ConnectCallback(&rec)
+
+	if le.Capabilities()&stack.CapabilityTXChecksumOffload == 0 {
+		t.Fatal("the stack still computes checksums for an in-process VM")
+	}
+
+	// From the guest: the stack gets the frame without its Ethernet header,
+	// and the switch learns the guest's MAC.
+	in := frame(7)
+	in[0], in[1], in[2], in[3], in[4], in[5] = stackMAC[0], stackMAC[1], stackMAC[2], stackMAC[3], stackMAC[4], stackMAC[5]
+	copy(in[6:12], guestMAC)
+	link.Inject(in, buffer.MakeWithData(in))
+	if len(gw.delivered) != 1 || !bytes.Equal(gw.delivered[0], in[header.EthernetMinimumSize:]) {
+		t.Fatalf("stack got %x", gw.delivered)
+	}
+
+	// To the guest: written at once, whatever its size, with the header.
+	payload := bytes.Repeat([]byte{9}, 3*txInlineMax)
+	pkt := outboundTCP(t, payload)
+	sw.DeliverNetworkPacket(header.IPv4ProtocolNumber, pkt)
+	want := pkt.ToView().AsSlice()
+	pkt.DecRef()
+	if len(rec.frames) != 1 {
+		t.Fatalf("%d frames written, want 1 without queueing", len(rec.frames))
+	}
+	if !bytes.Equal(rec.frames[0].frame, want) || rec.frames[0].hdr[0] != virtioNetHdrFNeedsCsum {
+		t.Fatalf("wrote header % x and a %d-byte frame", rec.frames[0].hdr, len(rec.frames[0].frame))
+	}
+}
