+//go:build cgo && (darwin || linux)
+
+package main
+
+import (
+	"bytes"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+type chanWriter chan []byte
+
+func (c chanWriter) WritePacket(_ []byte, frame [][]byte) error {
+	c <- bytes.Join(frame, nil)
+	return nil
+}
+
+// The guest asks for the gateway's MAC and gets gVisor's answer back through
+// the writer: flags, run, the switch and the link all work in-process.
+func TestInprocAnswersTheGuest(t *testing.T) {
+	dir, err := os.MkdirTemp("", "gvinproc")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer os.RemoveAll(dir)
+	frames := make(chanWriter, 16)
+	err = startInproc([]string{
+		"-services", "unix://" + filepath.Join(dir, "api.sock"),
+		"-ssh-port", "-1",
+		"-mtu", "65520",
+		"-subnet", "192.168.127.0/24",
+		"-gatewayIP", "192.168.127.1",
+		"-deviceIP", "192.168.127.2",
+		"-log-file", filepath.Join(dir, "gvproxy.log"),
+	}, frames)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "api.sock")); err != nil {
+		t.Fatalf("services API: %v", err)
+	}
+	if err := startInproc(nil, frames); err == nil {
+		t.Fatal("a second start succeeded")
+	}
+
+	guestMAC := net.HardwareAddr{0x5a, 0x94, 0xef, 0xe4, 0x0c, 0xee}
+	req := make([]byte, header.EthernetMinimumSize+header.ARPSize)
+	eth := header.Ethernet(req)
+	eth.Encode(&header.EthernetFields{SrcAddr: "\x5a\x94\xef\xe4\x0c\xee", DstAddr: header.EthernetBroadcastAddress, Type: header.ARPProtocolNumber})
+	arp := header.ARP(req[header.EthernetMinimumSize:])
+	arp.SetIPv4OverEthernet()
+	arp.SetOp(header.ARPRequest)
+	copy(arp.HardwareAddressSender(), guestMAC)
+	copy(arp.ProtocolAddressSender(), net.IPv4(192, 168, 127, 2).To4())
+	copy(arp.ProtocolAddressTarget(), net.IPv4(192, 168, 127, 1).To4())
+	inprocLink.Load().Inject(req, buffer.MakeWithData(req))
+
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case f := <-frames:
+			if header.Ethernet(f).Type() != header.ARPProtocolNumber {
+				continue
+			}
+			reply := header.ARP(f[header.EthernetMinimumSize:])
+			if reply.Op() != header.ARPReply || !bytes.Equal(reply.ProtocolAddressSender(), net.IPv4(192, 168, 127, 1).To4()) {
+				t.Fatalf("unexpected ARP % x", f)
+			}
+			return
+		case <-deadline:
+			t.Fatal("no ARP reply from the gateway")
+		}
+	}
+}
