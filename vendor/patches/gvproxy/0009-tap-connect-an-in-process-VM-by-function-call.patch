diff --git a/pkg/tap/vnethdr.go b/pkg/tap/vnethdr.go
new file mode 100644
index 0000000..bd8ad62
--- /dev/null
+++ b/pkg/tap/vnethdr.go
@@ -0,0 +1,66 @@
+package tap
+
+import (
+	"encoding/binary"
+
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+)
+
+// virtioNetHdrLen is the size of struct virtio_net_hdr_v1.
+const virtioNetHdrLen = 12
+
+const virtioNetHdrFNeedsCsum = 1
+
+// udpChecksumOffset is the checksum field's offset in a UDP header; gVisor's
+// header package keeps its constant unexported.
+const udpChecksumOffset = 6
+
+// guestNetHeader returns the virtio-net header for a frame to the VM. A TCP
+// or UDP frame from the stack carries no checksum (the link offloads it), so
+// the header asks the guest to treat it as CHECKSUM_PARTIAL: csum_start and
+// csum_offset locate the field, which is set here to the pseudo-header sum
+// as Linux expects. The guest then trusts it on local delivery and fills it
+// in only if it forwards the frame to a device that needs it.
+func guestNetHeader(pkt *stack.PacketBuffer) (h [virtioNetHdrLen]byte) {
+	var off int
+	switch pkt.TransportProtocolNumber {
+	case header.TCPProtocolNumber:
+		off = header.TCPChecksumOffset
+	case header.UDPProtocolNumber:
+		off = udpChecksumOffset
+	default:
+		return h
+	}
+	nh := pkt.NetworkHeader().Slice()
+	th := pkt.TransportHeader().Slice()
+	if len(th) < off+2 {
+		return h
+	}
+	var src, dst tcpip.Address
+	switch pkt.NetworkProtocolNumber {
+	case header.IPv4ProtocolNumber:
+		if len(nh) < header.IPv4MinimumSize {
+			return h
+		}
+		ip := header.IPv4(nh)
+		src, dst = ip.SourceAddress(), ip.DestinationAddress()
+	case header.IPv6ProtocolNumber:
+		if len(nh) < header.IPv6MinimumSize {
+			return h
+		}
+		ip := header.IPv6(nh)
+		src, dst = ip.SourceAddress(), ip.DestinationAddress()
+	default:
+		return h
+	}
+	length := len(th) + pkt.Data().Size()
+	sum := header.PseudoHeaderChecksum(pkt.TransportProtocolNumber, src, dst, uint16(length))
+	binary.BigEndian.PutUint16(th[off:], sum)
+
+	h[0] = virtioNetHdrFNeedsCsum
+	binary.LittleEndian.PutUint16(h[6:], uint16(header.EthernetMinimumSize+len(nh)))
+	binary.LittleEndian.PutUint16(h[8:], uint16(off))
+	return h
+}
