diff --git a/cmd/gvproxy/inproc.go b/cmd/gvproxy/inproc.go
new file mode 100644
index 0000000..aacba37
--- /dev/null
+++ b/cmd/gvproxy/inproc.go
@@ -0,0 +1,165 @@
+//go:build cgo && (darwin || linux)
+
+package main
+
+// In-process mode: a VMM loads this command built with -buildmode=c-shared
+// (main does not run) and calls kat_gvproxy_start with gvproxy's command line,
+// without -listen-vfkit. Frames then pass by function call both ways, with
+// no socket and no thread hand-off: kat_gvproxy_tx takes a frame from the
+// guest on the VMM's thread, and the stack writes frames for the guest
+// through the VMM's rx function on the goroutine that produced them.
+
+/*
+#include <sys/uio.h>
+
+// Writes one frame (virtio-net header, then the frame) to the guest. Returns
+// 0, or an errno; EAGAIN means the guest had no room and the frame is dropped.
+typedef int (*kat_rx_fn)(void *ctx, const struct iovec *iov, int iovcnt);
+
+static int kat_call_rx(kat_rx_fn fn, void *ctx, const struct iovec *iov, int iovcnt) {
+	return fn(ctx, iov, iovcnt);
+}
+*/
+import "C"
+
+import (
+	"context"
+	"errors"
+	"flag"
+	"runtime"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/tap"
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/containers/gvisor-tap-vsock/pkg/virtualnetwork"
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/sync/errgroup"
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+)
+
+var inprocLink atomic.Pointer[tap.CallbackLink]
+
+//export kat_gvproxy_start
+func kat_gvproxy_start(argc C.int, argv **C.char, rx C.kat_rx_fn, rxCtx unsafe.Pointer) C.int {
+	if rx == nil {
+		return C.int(syscall.EINVAL)
+	}
+	args := make([]string, int(argc))
+	for i, a := range unsafe.Slice(argv, int(argc)) {
+		args[i] = C.GoString(a)
+	}
+	err := startInproc(args, &guestWriter{rx: rx, ctx: rxCtx})
+	if err != nil {
+		log.Errorf("gvproxy: %v", err)
+		var errno syscall.Errno
+		if errors.As(err, &errno) {
+			return C.int(errno)
+		}
+		return C.int(syscall.EINVAL)
+	}
+	return 0
+}
+
+// startInproc starts gvproxy as its command line would, with w in place of
+// a vfkit socket, and returns once the VM is connected.
+func startInproc(argv []string, w tap.PacketWriter) error {
+	if inprocAttach != nil {
+		return syscall.EBUSY
+	}
+	var args GvproxyArgs
+	var config GvproxyConfig
+	if _, err := GvproxyArgParse(flag.NewFlagSet("gvproxy", flag.ContinueOnError), &args, argv); err != nil {
+		return err
+	}
+	if args.vfkitSocket != "" || args.qemuSocket != "" || args.bessSocket != "" || args.vpnkitSocket != "" || args.stdioSocket != "" {
+		return errors.New("in-process mode takes no VM socket")
+	}
+	cfg, err := GvproxyConfigure(&config, &args, types.NewVersion("gvproxy").String())
+	if err != nil {
+		return err
+	}
+	log.Info(GvproxyVersion())
+
+	attached := make(chan struct{})
+	inprocAttach = func(vn *virtualnetwork.VirtualNetwork) {
+		inprocLink.Store(vn.ConnectCallback(w))
+		close(attached)
+	}
+	g, ctx := errgroup.WithContext(context.Background())
+	g.Go(func() error {
+		return run(ctx, g, cfg)
+	})
+	failed := make(chan error, 1)
+	go func() {
+		err := g.Wait()
+		log.Errorf("gvproxy stopped: %v", err)
+		failed <- err
+	}()
+	select {
+	case <-attached:
+		return nil
+	case err := <-failed:
+		return err
+	}
+}
+
+//export kat_gvproxy_tx
+func kat_gvproxy_tx(iov *C.struct_iovec, iovcnt C.int) C.int {
+	link := inprocLink.Load()
+	if link == nil {
+		return C.int(syscall.ENOTCONN)
+	}
+	return C.int(injectFrame(link, unsafe.Slice(iov, int(iovcnt))))
+}
+
+// injectFrame copies the frame in vecs (guest memory) into a buffer for the
+// stack and switches it.
+func injectFrame(link *tap.CallbackLink, vecs []C.struct_iovec) syscall.Errno {
+	total := 0
+	for _, v := range vecs {
+		total += int(v.iov_len)
+	}
+	if total < header.EthernetMinimumSize {
+		return syscall.EINVAL
+	}
+	view := buffer.NewViewSize(total)
+	frame := view.AsSlice()
+	n := 0
+	for _, v := range vecs {
+		n += copy(frame[n:], unsafe.Slice((*byte)(v.iov_base), int(v.iov_len)))
+	}
+	link.Inject(frame, buffer.MakeWithView(view))
+	return 0
+}
+
+// guestWriter writes frames for the guest through the VMM's rx function.
+type guestWriter struct {
+	rx  C.kat_rx_fn
+	ctx unsafe.Pointer
+}
+
+func (w *guestWriter) WritePacket(hdr []byte, frame [][]byte) error {
+	// The iovecs point into Go memory the call only reads; pinning keeps
+	// cgo's pointer rules.
+	var pinner runtime.Pinner
+	defer pinner.Unpin()
+	iov := make([]C.struct_iovec, 0, len(frame)+1)
+	for _, b := range append([][]byte{hdr}, frame...) {
+		if len(b) == 0 {
+			continue
+		}
+		pinner.Pin(&b[0])
+		iov = append(iov, C.struct_iovec{iov_base: unsafe.Pointer(&b[0]), iov_len: C.size_t(len(b))})
+	}
+	switch r := syscall.Errno(C.kat_call_rx(w.rx, w.ctx, &iov[0], C.int(len(iov)))); r {
+	case 0, syscall.EAGAIN:
+		// A full guest queue drops the frame, as a full NIC ring does;
+		// TCP recovers it. Reporting it would disconnect the VM.
+		return nil
+	default:
+		return r
+	}
+}
