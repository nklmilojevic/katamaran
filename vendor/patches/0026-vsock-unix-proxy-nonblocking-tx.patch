+        assert!(!proxy.tx_buf.is_empty());
+        // tx_cnt only counts bytes accepted by the host kernel, never buffered bytes.
+        assert_eq!(
+            proxy.tx_cnt.0 as usize + proxy.tx_buf.len(),
+            total_sent.len()
