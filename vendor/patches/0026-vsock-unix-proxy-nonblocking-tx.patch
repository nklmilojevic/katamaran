+        let mut disarmed_out = false;
+        for _ in 0..1024 {
+            loop {
+                match peer.read(&mut tmp) {
+                    Ok(0) => break,
+                    Ok(n) => received.extend_from_slice(&tmp[..n]),
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => break,
