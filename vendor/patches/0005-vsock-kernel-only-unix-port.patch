+    /// Listen on a Unix socket for the host, like `add_unix_port` with
+    /// `listen`, but accept only connections the host kernel makes itself
+    /// (peer pid 0), such as the macOS NFS client's.
+    pub fn add_unix_port_kernel_only(&mut self, port: u32, path: &str) {
+        kernel_peer::restrict_to_kernel(Path::new(path));
+        self.add_unix_port(port, path, true);
+    }
